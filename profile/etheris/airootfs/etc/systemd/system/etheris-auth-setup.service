[Unit]
Description=Etheris OS authentication setup (live user, passwords, sudo)
DefaultDependencies=no
After=systemd-sysusers.service local-fs.target
Before=display-manager.service greetd.service systemd-user-sessions.service
Wants=systemd-sysusers.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/etheris-auth-setup
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target graphical.target
