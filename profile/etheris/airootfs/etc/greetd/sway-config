# Etheris OS — minimal Sway seat for ReGreet (login only)
# No Waybar / desktop chrome — greeter owns the viewport.

xwayland disable
# Solid seat bg only — ReGreet draws the wallpaper (avoid double paint on TCG/virtio).
output * bg #061018 solid_color

# Seat input
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
input type:keyboard {
    xkb_layout us
}

# Layer-shell friendly defaults
default_border none
default_floating_border none

exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
# Cairo GTK renderer: virtio software GL blanks/corrupts ReGreet without it.
exec "etheris-greeter; swaymsg exit"

bindsym Mod4+Shift+e exec swaynag -t warning -m 'Power?' -b 'Reboot' 'systemctl reboot' -b 'Shut down' 'systemctl poweroff' -b 'Cancel' ''
