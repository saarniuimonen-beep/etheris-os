/* Etheris OS — sleek icon-grid application launcher */
configuration {
  modi: "drun,pinned:/usr/local/share/etheris/rofi/favorites.mode,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "Noto Sans 12";
  terminal: "foot";
  drun-display-format: "{name}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: [ MousePrimary ];
  sidebar-mode: false;
  cycle: true;
  matching: "fuzzy";
  sort: true;
  display-drun: "Apps";
  display-pinned: "Pinned";
  display-run: "Run";
  display-window: "Windows";
}
@theme "etheris-slim"
