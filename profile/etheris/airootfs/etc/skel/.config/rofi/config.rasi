/* Etheris OS — Spotlight application launcher */
configuration {
  modi: "drun,pinned:/usr/local/share/etheris/rofi/favorites.mode,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "Noto Sans 12";
  terminal: "foot";
  drun-display-format: "{name}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: [ MousePrimary ];
  sidebar-mode: false;
  cycle: true;
  matching: "fuzzy";
  sort: true;
  normalize-match: true;
  display-drun: "Apps";
  display-pinned: "Pinned";
  display-run: "Run";
  display-window: "Windows";
  /* Arrows move the icon grid; Ctrl+B / Ctrl+F move the search caret */
  kb-move-char-back: "Control+b";
  kb-move-char-forward: "Control+f";
  kb-row-left: "Left";
  kb-row-right: "Right";
  kb-row-up: "Up";
  kb-row-down: "Down";
  kb-accept-entry: "Return,KP_Enter";
  kb-cancel: "Escape";
}
@theme "etheris-slim"
