/* Etheris OS — Rofi · Spotlight slim (compact landscape) */
/* Generated by etheris-theme-apply — do not edit by hand */

* {
  et-bg: rgba(10, 22, 40, 0.94);
  et-input: transparent;
  et-fg: #e8f4fc;
  et-muted: #a8c4d8;
  et-subtle: #6b8aa3;
  et-accent: #38bdf8;
  et-accent-soft: rgba(56, 189, 248, 0.35);
  et-border: rgba(56, 189, 248, 0.28);
  et-highlight: rgba(255, 255, 255, 0.12);
  et-sel: rgba(56, 189, 248, 0.35);
  et-glow: #7dd3fc;
  et-radius: 20px;
  et-radius-sm: 14px;
  font: "Noto Sans 12";
  background-color: transparent;
  text-color: @et-fg;
}

configuration {
  show-icons: true;
  drun-display-format: "{name}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: [ MousePrimary ];
  cycle: true;
  matching: "fuzzy";
  sort: true;
  normalize-match: true;
  kb-move-char-back: "Control+b";
  kb-move-char-forward: "Control+f";
  kb-row-left: "Left";
  kb-row-right: "Right";
  kb-row-up: "Up";
  kb-row-down: "Down";
  kb-accept-entry: "Return,KP_Enter";
  kb-cancel: "Escape";
}

window {
  background-color: @et-bg;
  /* Soft accent hairline — cleaner than a flat grey box outline */
  border: 1px;
  border-color: @et-border;
  border-radius: @et-radius;
  padding: 16px 18px 14px;
  width: 560px;
}

mainbox {
  spacing: 14px;
  children: [ inputbar, listview ];
  background-color: transparent;
}

inputbar {
  background-color: @et-input;
  border: 0px 0px 1px 0px;
  border-color: @et-border;
  border-radius: 0;
  padding: 0px 2px 12px;
  spacing: 0;
  children: [ entry ];
  margin: 0px 4px;
}

prompt {
  enabled: false;
}

entry {
  placeholder: "Search";
  placeholder-color: @et-subtle;
  text-color: @et-fg;
  cursor: text;
  background-color: transparent;
  padding: 0;
  font: "Noto Sans 15";
  vertical-align: 0.5;
}

message {
  padding: 0;
  text-color: @et-muted;
}

mode-switcher {
  enabled: false;
}

listview {
  lines: 2;
  columns: 6;
  spacing: 6px;
  scrollbar: false;
  background-color: transparent;
  cycle: true;
  fixed-height: true;
  flow: horizontal;
}

element {
  orientation: vertical;
  padding: 10px 6px 8px;
  spacing: 8px;
  /* Capsule selection — not a square outline */
  border-radius: 999px;
  border: 1px;
  border-color: transparent;
  background-color: transparent;
  text-color: @et-subtle;
  cursor: pointer;
  margin: 1px;
}

element normal.normal {
  background-color: transparent;
  text-color: @et-subtle;
  border-color: transparent;
}

element alternate.normal {
  background-color: transparent;
  text-color: @et-subtle;
  border-color: transparent;
}

element selected.normal {
  background-color: @et-sel;
  border-color: @et-glow;
  text-color: @et-fg;
}

element-icon {
  size: 40px;
  background-color: transparent;
  horizontal-align: 0.5;
  border-radius: 12px;
}

element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
  text-color: inherit;
  font: "Noto Sans 9";
}
