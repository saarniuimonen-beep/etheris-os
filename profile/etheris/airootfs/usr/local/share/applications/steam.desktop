[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=etheris-steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Exit;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true

[Desktop Action Store]
Name=Store
Exec=etheris-steam steam://store

[Desktop Action Community]
Name=Community
Exec=etheris-steam steam://url/SteamIDControlPage

[Desktop Action Library]
Name=Library
Exec=etheris-steam steam://open/games

[Desktop Action Servers]
Name=Servers
Exec=etheris-steam steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec=etheris-steam steam://open/screenshots

[Desktop Action News]
Name=News
Exec=etheris-steam steam://open/news

[Desktop Action Settings]
Name=Settings
Exec=etheris-steam steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec=etheris-steam steam://open/bigpicture

[Desktop Action Exit]
Name=Exit
Exec=etheris-steam -shutdown
