/* Etheris OS — Rofi launcher · Slim icon grid */
/* Generated by etheris-theme-apply — do not edit by hand */

* {
  et-bg: @BG_MENU_RGBA@;
  et-input: @BG_INPUT_RGBA@;
  et-fg: @FG@;
  et-muted: @FG_MUTED@;
  et-accent: @ACCENT@;
  et-accent-soft: @ACCENT_SOFT_RGBA@;
  et-highlight: @HIGHLIGHT@;
  et-radius: @RADIUS_MENU@px;
  et-radius-sm: @RADIUS_CONTROL@px;
  font: "@FONT_UI@ 12";
  background-color: transparent;
  text-color: @et-fg;
}

window {
  background-color: @et-bg;
  border: none;
  border-radius: @et-radius;
  padding: 14px;
  width: 520px;
}

mainbox {
  spacing: 12px;
  children: [ inputbar, listview ];
}

inputbar {
  background-color: @et-input;
  border: none;
  border-radius: @et-radius-sm;
  padding: 10px 14px;
  spacing: 10px;
  children: [ entry ];
}

prompt {
  enabled: false;
}

entry {
  placeholder: "Search apps";
  placeholder-color: @et-muted;
  text-color: @et-fg;
  cursor: text;
  background-color: transparent;
}

message {
  padding: 0;
  text-color: @et-muted;
}

mode-switcher {
  enabled: false;
}

listview {
  lines: 3;
  columns: 4;
  spacing: 8px;
  scrollbar: false;
  background-color: transparent;
  cycle: true;
  fixed-height: true;
}

element {
  orientation: vertical;
  padding: 12px 8px;
  spacing: 8px;
  border-radius: @et-radius-sm;
  border: none;
  background-color: transparent;
  text-color: @et-muted;
}

element selected {
  background-color: @et-accent-soft;
  text-color: @et-fg;
}

element-icon {
  size: 40px;
  background-color: transparent;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
  text-color: inherit;
  font: "@FONT_UI@ 11";
}
