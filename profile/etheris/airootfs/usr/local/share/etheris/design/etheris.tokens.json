{
  "$schema": "etheris-os-design-tokens/v2",
  "meta": {
    "name": "Etheris Neo-Aero",
    "phase": 2,
    "defaultAtmosphere": "ocean-glass",
    "blurDefault": "off",
    "fontUi": "Outfit",
    "fontMono": "JetBrains Mono"
  },
  "geometry": {
    "spaceUnitPx": 4,
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
    "radius": { "control": 8, "panel": 14, "menu": 14, "dialog": 16, "window": 12, "pill": 999 },
    "borderWidthPx": 1,
    "panelHeightPx": 40,
    "panelTopOffsetPx": 14,
    "controlCenterMaxWidthPx": 360,
    "launcherMaxWidthPx": 640,
    "focusRingPx": 3
  },
  "type": {
    "display": { "sizePx": 40, "weight": 700, "lineHeight": 1.2 },
    "title": { "sizePx": 22, "weight": 600, "lineHeight": 1.2 },
    "heading": { "sizePx": 18, "weight": 600, "lineHeight": 1.3 },
    "body": { "sizePx": 14, "weight": 400, "lineHeight": 1.45 },
    "caption": { "sizePx": 12, "weight": 500, "lineHeight": 1.4 },
    "micro": { "sizePx": 11, "weight": 500, "lineHeight": 1.3 }
  },
  "motion": {
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "hoverMs": 80,
    "openMs": 180,
    "closeMs": 140,
    "pageMs": 220
  },
  "shadow": {
    "soft": "0 8px 28px rgba(8, 24, 48, 0.28)",
    "float": "0 12px 40px rgba(8, 24, 48, 0.36)",
    "softLight": "0 8px 28px rgba(12, 60, 100, 0.12)",
    "floatLight": "0 12px 40px rgba(12, 60, 100, 0.16)",
    "insetGloss": "inset 0 1px 0 rgba(255, 255, 255, 0.18)"
  },
  "semanticStatus": {
    "dark": { "success": "#4ade80", "warning": "#fbbf24", "danger": "#fb7185" },
    "light": { "success": "#16a34a", "warning": "#d97706", "danger": "#e11d48" }
  },
