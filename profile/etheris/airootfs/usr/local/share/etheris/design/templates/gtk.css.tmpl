/* Etheris Flow — GTK 3/4 (generated by etheris-theme-apply)
 * Glass surfaces, soft accent chrome, rounded controls.
 * Styles PCManFM (Etheris Files) and other GTK apps.
 * Component classes (.etheris-*) match design/phase-2 COMPONENTS.md.
 */

@define-color etheris_bg @BG@;
@define-color etheris_bg_elevated @BG_ELEVATED@;
@define-color etheris_bg_deep @BG_DEEP@;
@define-color etheris_fg @FG@;
@define-color etheris_muted @FG_MUTED@;
@define-color etheris_subtle @FG_SUBTLE@;
@define-color etheris_accent @ACCENT@;
@define-color etheris_accent2 @ACCENT_2@;
@define-color etheris_danger @DANGER@;
@define-color etheris_success @SUCCESS@;
@define-color etheris_warning @WARNING@;
@define-color etheris_focus @FOCUS@;

* {
  font-family: "@FONT_UI@", "Cantarell", "Noto Sans", sans-serif;
  -gtk-icon-style: regular;
}

window,
.background {
  background-color: @etheris_bg;
  color: @etheris_fg;
}

/* —— Client-side decorations —— */
headerbar {
  background-image: linear-gradient(
    180deg,
    alpha(@etheris_fg, 0.06) 0%,
    transparent 55%
  );
  background-color: alpha(@etheris_bg_elevated, 0.96);
  color: @etheris_fg;
  border-bottom: 1px solid alpha(@etheris_accent, 0.28);
  padding: 6px 12px;
  min-height: 40px;
  box-shadow: inset 0 1px 0 alpha(@etheris_fg, 0.08);
}

headerbar label,
headerbar .title {
  color: @etheris_fg;
  font-weight: 600;
  letter-spacing: 0.01em;
}

headerbar button.titlebutton {
  min-width: 28px;
  min-height: 28px;
  border-radius: 999px;
  padding: 0;
  margin: 0 3px;
  background: alpha(@etheris_fg, 0.07);
  color: @etheris_muted;
  border: none;
  box-shadow: none;
}

headerbar button.titlebutton:hover {
  background: alpha(@etheris_accent, 0.24);
  color: @etheris_fg;
}

headerbar button.titlebutton:active {
  background: alpha(@etheris_accent, 0.38);
  color: @etheris_fg;
}

headerbar button.titlebutton:disabled {
  opacity: 0.35;
}

headerbar button.titlebutton.close:hover {
  background: alpha(@etheris_danger, 0.88);
  color: white;
}

headerbar button.titlebutton.close:active {
  background: @etheris_danger;
  color: white;
}

headerbar button.titlebutton.minimize:hover,
headerbar button.titlebutton.maximize:hover {
  background: alpha(@etheris_accent, 0.30);
  color: @etheris_fg;
}

window.csd,
window.solid-csd {
  border-radius: @RADIUS_MENU@px;
  border: 1px solid alpha(@etheris_accent, 0.32);
  box-shadow: 0 18px 48px alpha(@etheris_bg_deep, 0.55);
}

window.csd:backdrop,
window.solid-csd:backdrop {
  opacity: 0.97;
  border-color: alpha(@etheris_accent, 0.16);
}

/* —— Toolbars / path bar (PCManFM) —— */
toolbar,
.toolbar,
.primary-toolbar {
  background-color: alpha(@etheris_bg_elevated, 0.92);
  border-bottom: 1px solid alpha(@etheris_accent, 0.18);
  padding: 6px 8px;
  box-shadow: inset 0 1px 0 alpha(@etheris_fg, 0.05);
}

toolbar button,
.toolbar button,
button.flat,
button.image-button {
  border-radius: @RADIUS_CONTROL@px;
  padding: 6px 10px;
  background: transparent;
  border: 1px solid transparent;
  color: @etheris_muted;
  box-shadow: none;
}

toolbar button:hover,
.toolbar button:hover,
button.flat:hover,
button.image-button:hover {
  background: alpha(@etheris_accent, 0.16);
  border-color: alpha(@etheris_accent, 0.28);
  color: @etheris_fg;
}

toolbar button:checked,
toolbar button:active,
button.flat:checked {
  background: alpha(@etheris_accent, 0.24);
  border-color: alpha(@etheris_accent, 0.40);
  color: @etheris_fg;
}

entry,
.search,
.navigation-entry {
  background-color: @BG_INPUT_RGBA@;
  color: @etheris_fg;
  border: 1px solid alpha(@etheris_accent, 0.26);
  border-radius: @RADIUS_CONTROL@px;
  padding: 7px 11px;
  min-height: 28px;
  box-shadow: inset 0 1px 0 alpha(@etheris_fg, 0.04);
  caret-color: @etheris_accent;
}

entry:focus,
.search:focus {
  border-color: @etheris_accent;
  box-shadow: 0 0 0 2px alpha(@etheris_accent, 0.22);
}

entry selection {
  background-color: alpha(@etheris_accent, 0.35);
  color: @etheris_fg;
}

/* —— Buttons —— */
button {
  background-image: linear-gradient(
    180deg,
    alpha(@etheris_fg, 0.08) 0%,
    transparent 70%
  );
  background-color: alpha(@etheris_bg_elevated, 0.95);
  color: @etheris_fg;
  border: 1px solid alpha(@etheris_accent, 0.28);
  border-radius: @RADIUS_CONTROL@px;
  padding: 7px 14px;
  min-height: 28px;
  box-shadow: inset 0 1px 0 alpha(@etheris_fg, 0.06);
}

button:hover {
  background-color: alpha(@etheris_accent, 0.18);
  border-color: alpha(@etheris_accent, 0.45);
  color: @etheris_fg;
}

button:active,
button:checked {
  background-color: alpha(@etheris_accent, 0.28);
  border-color: @etheris_accent;
}

button.suggested-action,
button.default {
  background-image: linear-gradient(
    180deg,
    alpha(white, 0.18) 0%,
    transparent 60%
  );
  background-color: @etheris_accent;
  color: @etheris_bg_deep;
  border-color: alpha(@etheris_accent, 0.8);
  font-weight: 600;
}

button.suggested-action:hover,
button.default:hover {
  background-color: @etheris_focus;
  color: @etheris_bg_deep;
}

button.destructive-action:hover {
  background-color: alpha(@etheris_danger, 0.85);
  color: white;
  border-color: @etheris_danger;
}

/* —— Sidebar / places (file manager) —— */
paned > box:first-child,
.sidebar,
placessidebar,
treeview.sidebar {
  background-color: alpha(@etheris_bg_elevated, 0.88);
  color: @etheris_muted;
  border-right: 1px solid alpha(@etheris_accent, 0.16);
}

placessidebar viewport,
placessidebar list,
.sidebar list {
  background-color: transparent;
}

placessidebar row,
.sidebar row,
treeview.sidebar row {
  border-radius: @RADIUS_CONTROL@px;
  margin: 2px 6px;
  padding: 2px;
  min-height: 32px;
}

placessidebar row:hover,
.sidebar row:hover {
  background-color: alpha(@etheris_accent, 0.12);
}

placessidebar row:selected,
.sidebar row:selected,
treeview.sidebar:selected {
  background-color: alpha(@etheris_accent, 0.22);
  color: @etheris_fg;
  border: 1px solid alpha(@etheris_accent, 0.35);
}

placessidebar label,
.sidebar label {
  color: @etheris_muted;
  font-size: 12.5px;
}

placessidebar row:selected label,
.sidebar row:selected label {
  color: @etheris_fg;
  font-weight: 600;
}

/* —— File views —— */
iconview,
.view,
treeview,
listview {
  background-color: @etheris_bg;
  color: @etheris_fg;
  border-radius: 0;
}

iconview:selected,
iconview:selected:focus,
.view:selected,
treeview:selected,
treeview:selected:focus {
  background-color: alpha(@etheris_accent, 0.26);
  color: @etheris_fg;
  border-radius: @RADIUS_CONTROL@px;
}

iconview.view.cell:selected,
iconview.view.cell:selected:focus {
  background-color: alpha(@etheris_accent, 0.28);
  border-radius: 12px;
  outline: 1px solid alpha(@etheris_accent, 0.45);
}

/* Soft “glass pad” under icons */
iconview {
  -GtkWidget-focus-padding: 2;
  -GtkWidget-focus-line-width: 0;
}

/* —— Menus / popovers —— */
menu,
.menu,
.context-menu,
popover,
popover > contents {
  background-color: @BG_MENU_RGBA@;
  color: @etheris_fg;
  border: 1px solid alpha(@etheris_accent, 0.30);
  border-radius: @RADIUS_MENU@px;
  padding: 6px;
  box-shadow: 0 14px 40px alpha(@etheris_bg_deep, 0.45);
}

menuitem,
modelbutton,
popover modelbutton {
  border-radius: @RADIUS_CONTROL@px;
  padding: 7px 12px;
  min-height: 28px;
  color: @etheris_muted;
}

menuitem:hover,
modelbutton:hover,
menuitem:selected {
  background-color: alpha(@etheris_accent, 0.20);
  color: @etheris_fg;
}

separator {
  background-color: alpha(@etheris_accent, 0.18);
  min-height: 1px;
}

/* —— Scrollbars —— */
scrollbar {
  background-color: transparent;
}

scrollbar slider {
  background-color: alpha(@etheris_accent, 0.28);
  border-radius: 999px;
  min-width: 8px;
  min-height: 8px;
  margin: 2px;
}

scrollbar slider:hover {
  background-color: alpha(@etheris_accent, 0.48);
}

scrollbar slider:active {
  background-color: @etheris_accent;
}

/* —— Status bar / notebook —— */
statusbar,
.status-bar {
  background-color: alpha(@etheris_bg_elevated, 0.9);
  border-top: 1px solid alpha(@etheris_accent, 0.16);
  color: @etheris_muted;
  padding: 4px 10px;
  font-size: 12px;
}

notebook > header {
  background-color: alpha(@etheris_bg_elevated, 0.9);
  border-color: alpha(@etheris_accent, 0.18);
}

notebook > header > tabs > tab {
  border-radius: @RADIUS_CONTROL@px @RADIUS_CONTROL@px 0 0;
  padding: 6px 12px;
  color: @etheris_muted;
  background-color: transparent;
  border: none;
}

notebook > header > tabs > tab:checked {
  background-color: alpha(@etheris_accent, 0.16);
  color: @etheris_fg;
  box-shadow: inset 0 -2px 0 @etheris_accent;
}

notebook > stack {
  background-color: @etheris_bg;
}

/* —— Progress / switches —— */
progressbar trough {
  background-color: alpha(@etheris_fg, 0.08);
  border-radius: 999px;
  border: none;
  min-height: 8px;
}

progressbar progress {
  background-color: @etheris_accent;
  border-radius: 999px;
}

switch {
  background-color: alpha(@etheris_fg, 0.12);
  border-radius: 999px;
  border: 1px solid alpha(@etheris_accent, 0.2);
}

switch:checked {
  background-color: alpha(@etheris_accent, 0.55);
  border-color: @etheris_accent;
}

switch slider {
  background-color: @etheris_fg;
  border-radius: 999px;
  min-width: 18px;
  min-height: 18px;
}

/* —— Tooltips —— */
tooltip,
tooltip.background {
  background-color: @BG_MENU_RGBA@;
  color: @etheris_fg;
  border: 1px solid alpha(@etheris_accent, 0.35);
  border-radius: @RADIUS_CONTROL@px;
  padding: 6px 10px;
}

/* —— Dialogs —— */
dialog,
messagedialog,
.window-frame {
  background-color: @BG_MENU_RGBA@;
  color: @etheris_fg;
  border-radius: @RADIUS_MENU@px;
}

/* —— Selection / links —— */
*:selected {
  background-color: alpha(@etheris_accent, 0.28);
  color: @etheris_fg;
}

link,
a {
  color: @etheris_accent;
}

link:hover,
a:hover {
  color: @etheris_focus;
}

/* —— Frame / scrolled glass —— */
scrolledwindow,
frame > border {
  border-color: alpha(@etheris_accent, 0.14);
}

overshoot.top,
overshoot.bottom,
overshoot.left,
overshoot.right,
undershoot.top,
undershoot.bottom {
  background: none;
}

/* —— Etheris Flow component helpers (GTK apps) —— */
.etheris-card,
frame.etheris-card {
  background-color: alpha(@etheris_bg_elevated, 0.92);
  border: 1px solid alpha(@etheris_accent, 0.22);
  border-radius: @RADIUS_MENU@px;
  padding: 12px;
  box-shadow: inset 0 1px 0 alpha(@etheris_fg, 0.06);
}

.etheris-title {
  color: @etheris_fg;
  font-weight: 600;
  font-size: 18px;
}

.etheris-caption {
  color: @etheris_muted;
  font-size: 12px;
}

.etheris-muted {
  color: @etheris_muted;
}

button.etheris-primary,
.etheris-primary {
  background-image: linear-gradient(
    180deg,
    alpha(white, 0.18) 0%,
    transparent 60%
  );
  background-color: @etheris_accent;
  color: @etheris_bg_deep;
  border-color: alpha(@etheris_accent, 0.8);
  font-weight: 600;
}

button.etheris-primary:hover,
.etheris-primary:hover {
  background-color: @etheris_focus;
  color: @etheris_bg_deep;
}

button.etheris-ghost {
  background: alpha(@etheris_fg, 0.06);
  border: 1px solid alpha(@etheris_accent, 0.28);
  color: @etheris_fg;
}

button.etheris-danger:hover {
  background-color: alpha(@etheris_danger, 0.85);
  color: white;
  border-color: @etheris_danger;
}

.etheris-focus-ring:focus,
.etheris-focus-ring:focus-visible {
  outline: 3px solid alpha(@etheris_accent, 0.35);
  outline-offset: 2px;
}
