/* Etheris OS — Rofi · Spotlight wide (compact landscape) */
/* Generated by etheris-theme-apply — do not edit by hand */

* {
  et-bg: @BG_MENU_RGBA@;
  et-input: transparent;
  et-fg: @FG@;
  et-muted: @FG_MUTED@;
  et-subtle: @FG_SUBTLE@;
  et-accent: @ACCENT@;
  et-accent-soft: @ACCENT_SOFT_RGBA@;
  et-border: @BORDER_RGBA@;
  et-highlight: @HIGHLIGHT@;
  et-sel: @ACCENT_SOFT_RGBA@;
  et-glow: @FOCUS@;
  et-radius: 22px;
  et-radius-sm: 14px;
  font: "@FONT_UI@ 12";
  background-color: transparent;
  text-color: @et-fg;
}

configuration {
  show-icons: true;
  drun-display-format: "{name}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: [ MousePrimary ];
  cycle: true;
  matching: "fuzzy";
  sort: true;
  normalize-match: true;
  kb-move-char-back: "Control+b";
  kb-move-char-forward: "Control+f";
  kb-row-left: "Left";
  kb-row-right: "Right";
  kb-row-up: "Up";
  kb-row-down: "Down";
  kb-accept-entry: "Return,KP_Enter";
  kb-cancel: "Escape";
}

window {
  background-color: @et-bg;
  border: 1px;
  border-color: @et-border;
  border-radius: @et-radius;
  padding: 18px 20px 16px;
  width: 680px;
}

mainbox {
  spacing: 16px;
  children: [ inputbar, listview ];
  background-color: transparent;
}

inputbar {
  background-color: @et-input;
  border: 0px 0px 1px 0px;
  border-color: @et-border;
  border-radius: 0;
  padding: 0px 2px 14px;
  spacing: 0;
  children: [ entry ];
  margin: 0px 6px;
}

prompt {
  enabled: false;
}

entry {
  placeholder: "Search";
  placeholder-color: @et-subtle;
  text-color: @et-fg;
  cursor: text;
  background-color: transparent;
  padding: 0;
  font: "@FONT_UI@ 16";
  vertical-align: 0.5;
}

message {
  padding: 0;
  text-color: @et-muted;
}

mode-switcher {
  enabled: false;
}

listview {
  lines: 2;
  columns: 7;
  spacing: 6px;
  scrollbar: false;
  background-color: transparent;
  cycle: true;
  fixed-height: true;
  flow: horizontal;
}

element {
  orientation: vertical;
  padding: 10px 6px 8px;
  spacing: 8px;
  border-radius: 999px;
  border: 1px;
  border-color: transparent;
  background-color: transparent;
  text-color: @et-subtle;
  cursor: pointer;
  margin: 1px;
}

element normal.normal {
  background-color: transparent;
  text-color: @et-subtle;
  border-color: transparent;
}

element alternate.normal {
  background-color: transparent;
  text-color: @et-subtle;
  border-color: transparent;
}

element selected.normal {
  background-color: @et-sel;
  border-color: @et-glow;
  text-color: @et-fg;
}

element-icon {
  size: 42px;
  background-color: transparent;
  horizontal-align: 0.5;
  border-radius: 12px;
}

element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
  text-color: inherit;
  font: "@FONT_UI@ 9";
}
