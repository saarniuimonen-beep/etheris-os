/* Etheris OS — Neo-Aero Rofi launcher · Wide (default) */
/* Generated by etheris-theme-apply — do not edit by hand */

* {
  et-bg: @BG_MENU_RGBA@;
  et-panel: @BG_PANEL_RGBA@;
  et-input: @BG_INPUT_RGBA@;
  et-fg: @FG@;
  et-muted: @FG_MUTED@;
  et-accent: @ACCENT@;
  et-accent-soft: @ACCENT_SOFT_RGBA@;
  et-border: @BORDER_RGBA@;
  et-highlight: @HIGHLIGHT@;
  et-radius: @RADIUS_MENU@px;
  et-radius-sm: @RADIUS_CONTROL@px;
  font: "@FONT_UI@ 13";
  background-color: transparent;
  text-color: @et-fg;
}

window {
  background-color: @et-bg;
  border: 1px solid;
  border-color: @et-border;
  border-radius: @et-radius;
  padding: 16px;
  width: 680px;
}

mainbox {
  spacing: 14px;
  children: [ inputbar, message, mode-switcher, listview ];
}

inputbar {
  background-color: @et-input;
  border: 1px solid;
  border-color: @et-border;
  border-radius: @et-radius-sm;
  padding: 12px 16px;
  spacing: 12px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @et-accent;
  font: "@FONT_UI@ Bold 13";
}

entry {
  placeholder: "Search apps…";
  placeholder-color: @et-muted;
  text-color: @et-fg;
  cursor: text;
}

message {
  padding: 6px 4px;
  text-color: @et-muted;
}

mode-switcher {
  spacing: 8px;
  background-color: transparent;
  expand: false;
}

button {
  background-color: transparent;
  text-color: @et-muted;
  border: 1px solid;
  border-color: @et-border;
  border-radius: 999px;
  padding: 8px 16px;
}

button selected {
  background-color: @et-accent-soft;
  text-color: @et-fg;
  border-color: @et-accent;
}

listview {
  lines: 10;
  columns: 1;
  spacing: 5px;
  scrollbar: false;
  background-color: transparent;
}

element {
  padding: 10px 14px;
  spacing: 14px;
  border-radius: @et-radius-sm;
  border: 1px solid;
  border-color: transparent;
  background-color: transparent;
  text-color: @et-muted;
}

element selected {
  background-color: @et-accent-soft;
  border-color: @et-border;
  text-color: @et-fg;
}

element-icon {
  size: 30px;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}
