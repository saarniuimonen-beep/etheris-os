/* Etheris OS — Neo-Aero Rofi · Wide (fallback pre-theme-apply) */

* {
  et-bg: rgba(10, 22, 40, 0.94);
  et-panel: rgba(10, 22, 40, 0.72);
  et-input: rgba(18, 35, 56, 0.92);
  et-fg: #e8f4fc;
  et-muted: #a8c4d8;
  et-accent: #38bdf8;
  et-accent-soft: rgba(56, 189, 248, 0.18);
  et-border: rgba(56, 189, 248, 0.28);
  et-highlight: rgba(255, 255, 255, 0.12);
  et-radius: 16px;
  et-radius-sm: 10px;
  font: "Outfit 13";
  background-color: transparent;
  text-color: @et-fg;
}

window {
  background-color: @et-bg;
  border: 1px solid;
  border-color: @et-border;
  border-radius: @et-radius;
  padding: 16px;
  width: 680px;
}

mainbox {
  spacing: 14px;
  children: [ inputbar, message, mode-switcher, listview ];
}

inputbar {
  background-color: @et-input;
  border: 1px solid;
  border-color: @et-border;
  border-radius: @et-radius-sm;
  padding: 12px 16px;
  spacing: 12px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @et-accent;
  font: "Outfit Bold 13";
}

entry {
  placeholder: "Search apps…";
  placeholder-color: @et-muted;
  text-color: @et-fg;
  cursor: text;
}

message {
  padding: 6px 4px;
  text-color: @et-muted;
}

mode-switcher {
  spacing: 8px;
  background-color: transparent;
  expand: false;
}

button {
  background-color: transparent;
  text-color: @et-muted;
  border: 1px solid;
  border-color: @et-border;
  border-radius: 999px;
  padding: 8px 16px;
}

button selected {
  background-color: @et-accent-soft;
  text-color: @et-fg;
  border-color: @et-accent;
}

listview {
  lines: 10;
  columns: 1;
  spacing: 5px;
  scrollbar: false;
  background-color: transparent;
}

element {
  padding: 10px 14px;
  spacing: 14px;
  border-radius: @et-radius-sm;
  border: 1px solid;
  border-color: transparent;
  background-color: transparent;
  text-color: @et-muted;
}

element selected {
  background-color: @et-accent-soft;
  border-color: @et-border;
  text-color: @et-fg;
}

element-icon {
  size: 30px;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}
