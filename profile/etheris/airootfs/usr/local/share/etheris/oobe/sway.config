# Minimal Sway session used only while OOBE is outstanding.
set $mod Mod4
floating_modifier $mod normal
font pango:monospace 12
output * bg #0b1020 solid_color
seat * hide_cursor 5000
exec sh -c '/usr/bin/foot -T "Etheris OS setup" /usr/local/bin/etheris-oobe run 2>/tmp/etheris-oobe.log; ec=$?; if [ "$ec" -ne 0 ]; then /usr/bin/foot -T "OOBE error" sh -c "echo OOBE exit=$ec; echo --- log ---; cat /tmp/etheris-oobe.log 2>/dev/null; echo; read -r _"; fi'
