#!/usr/bin/env python3
"""Etheris OS — Session / power menu.

Minimalist frosted sheet over a one-shot blurred backdrop.
Lock · Sleep · Log out · Restart · Shut down — calm list with full
keyboard navigation (↑↓←→ · Enter · Esc · letter shortcuts).
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Prefer GL for smoother CSS motion when available; cairo remains OK.
if "GSK_RENDERER" not in os.environ:
    os.environ.setdefault("GSK_RENDERER", "cairo")

_LIB = Path(__file__).resolve().parent.parent / "share" / "etheris" / "lib"
if _LIB.is_dir():
    sys.path.insert(0, str(_LIB))

try:
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk
except (ImportError, ValueError) as exc:
    print(f"etheris-power-menu: GTK4/PyGObject required ({exc})", file=sys.stderr)
    print("Falling back is handled by `etheris logout-menu`.", file=sys.stderr)
    sys.exit(2)

from etheris_glass import (  # noqa: E402
    GLASS_MOTION_CSS,
    animations_on,
    close_ms,
    prepare_frosted_backdrop,
)

APP_ID = "os.etheris.PowerMenu"

# label, action, danger, shortcut glyph, letter keys
ACTIONS: list[tuple[str, str, bool, str, tuple[int, ...]]] = [
    (
        "Lock",
        "lock",
        False,
        "L",
        (Gdk.KEY_l, Gdk.KEY_L, Gdk.KEY_1, Gdk.KEY_KP_1),
    ),
    (
        "Sleep",
        "sleep",
        False,
        "S",
        (Gdk.KEY_s, Gdk.KEY_S, Gdk.KEY_2, Gdk.KEY_KP_2),
    ),
    (
        "Log out",
        "logout",
        False,
        "O",
        (Gdk.KEY_o, Gdk.KEY_O, Gdk.KEY_3, Gdk.KEY_KP_3),
    ),
    (
        "Restart",
        "reboot",
        False,
        "R",
        (Gdk.KEY_r, Gdk.KEY_R, Gdk.KEY_4, Gdk.KEY_KP_4),
    ),
    (
        "Shut down",
        "shutdown",
        True,
        "D",
        (Gdk.KEY_d, Gdk.KEY_D, Gdk.KEY_5, Gdk.KEY_KP_5),
    ),
]

NAV_UP = {
    Gdk.KEY_Up,
    Gdk.KEY_KP_Up,
    Gdk.KEY_Left,
    Gdk.KEY_KP_Left,
    Gdk.KEY_k,
    Gdk.KEY_K,
}
NAV_DOWN = {
    Gdk.KEY_Down,
    Gdk.KEY_KP_Down,
    Gdk.KEY_Right,
    Gdk.KEY_KP_Right,
    Gdk.KEY_j,
    Gdk.KEY_J,
}
ACTIVATE = {
    Gdk.KEY_Return,
    Gdk.KEY_KP_Enter,
    Gdk.KEY_space,
    Gdk.KEY_ISO_Enter,
}

# Chord masks that must not trigger nav / shortcuts / activate.
_CHORD_MASK = (
    Gdk.ModifierType.CONTROL_MASK
    | Gdk.ModifierType.ALT_MASK
    | Gdk.ModifierType.SUPER_MASK
    | Gdk.ModifierType.META_MASK
)


def _spawn(cmd: list[str]) -> bool:
    """Start a detached child. Returns True if the process was created."""
    try:
        subprocess.Popen(cmd, start_new_session=True)
        return True
    except OSError:
        return False


def run_action(action: str) -> None:
    if os.environ.get("ETHERIS_POWER_DRY_RUN") == "1":
        print(f"etheris-power-menu: dry-run action={action}", flush=True)
        return
    if action == "lock":
        for cmd in (
            ["etheris-lock"],
            ["swaylock", "-f", "-c", "0a1628"],
            ["loginctl", "lock-session"],
        ):
            if _spawn(cmd):
                return
    elif action == "sleep":
        _spawn(["systemctl", "suspend"])
    elif action == "logout":
        # Prefer compositor sockets over XDG_CURRENT_DESKTOP (often unset/wrong).
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            if _spawn(["hyprctl", "dispatch", "exit"]):
                return
        if os.environ.get("SWAYSOCK"):
            if _spawn(["swaymsg", "exit"]):
                return
        desktop = (os.environ.get("XDG_CURRENT_DESKTOP") or "").lower()
        if "hyprland" in desktop and _spawn(["hyprctl", "dispatch", "exit"]):
            return
        if _spawn(["swaymsg", "exit"]):
            return
        user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""
        if user:
            _spawn(["loginctl", "terminate-user", user])
    elif action == "reboot":
        _spawn(["systemctl", "reboot"])
    elif action == "shutdown":
        _spawn(["systemctl", "poweroff"])


class PowerMenu(Gtk.Application):
    _css_loaded = False

    def __init__(self, backdrop: str | None):
        super().__init__(application_id=APP_ID)
        self.backdrop = backdrop
        self._pending: str | None = None
        self._rows: list[Gtk.Button] = []
        self._actions: list[str] = []
        self._index = 0
        self._sheet: Gtk.Widget | None = None
        self._scrim: Gtk.Widget | None = None
        self._closing = False
        self._syncing_focus = False
        self._held = False

    def do_activate(self) -> None:  # noqa: N802
        wins = self.get_windows()
        if wins:
            self._dismiss()
            return
        self._build()

    def _build(self) -> None:
        # Empty title so the panel does not swap chrome for "Session".
        win = Gtk.ApplicationWindow(application=self, title="")
        win.set_decorated(False)
        win.set_resizable(False)
        # Size to the monitor before present — avoids a tiny tiled stub on
        # Hyprland/Sway when layer-shell is unavailable.
        mw, mh = self._monitor_size()
        win.set_default_size(mw, mh)

        overlay = Gtk.Overlay()
        win.set_child(overlay)

        if self.backdrop and os.path.isfile(self.backdrop):
            picture = Gtk.Picture.new_for_filename(self.backdrop)
            picture.set_content_fit(Gtk.ContentFit.COVER)
            picture.set_hexpand(True)
            picture.set_vexpand(True)
            overlay.set_child(picture)
        else:
            overlay.set_child(self._solid_bg())

        scrim = Gtk.Box()
        scrim.add_css_class("scrim")
        if animations_on():
            scrim.add_css_class("eth-scrim-enter")
        else:
            scrim.add_css_class("eth-scrim-open")
        scrim.set_hexpand(True)
        scrim.set_vexpand(True)
        self._scrim = scrim
        overlay.add_overlay(scrim)

        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sheet.set_halign(Gtk.Align.CENTER)
        sheet.set_valign(Gtk.Align.CENTER)
        sheet.add_css_class("pm-sheet")
        sheet.add_css_class("eth-glass-enter" if animations_on() else "eth-glass-open")
        sheet.set_size_request(372, -1)
        self._sheet = sheet

        # Brand header
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        head.add_css_class("pm-head")
        head.set_halign(Gtk.Align.FILL)

        mark_wrap = Gtk.Box()
        mark_wrap.add_css_class("pm-mark-wrap")
        mark_wrap.set_valign(Gtk.Align.CENTER)
        mark_wrap.set_halign(Gtk.Align.CENTER)
        mark = Gtk.Box()
        mark.add_css_class("pm-mark")
        mark.set_hexpand(False)
        mark.set_vexpand(False)
        mark.set_size_request(8, 8)
        mark_wrap.append(mark)

        brand = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        brand.set_valign(Gtk.Align.CENTER)
        brand.set_hexpand(True)
        word = Gtk.Label(label="Etheris")
        word.add_css_class("pm-brand")
        word.set_halign(Gtk.Align.START)
        word.set_xalign(0.0)
        sub = Gtk.Label(label="SESSION")
        sub.add_css_class("pm-sub")
        sub.set_halign(Gtk.Align.START)
        sub.set_xalign(0.0)
        brand.append(word)
        brand.append(sub)

        head.append(mark_wrap)
        head.append(brand)
        sheet.append(head)

        # Inset list well — rows sit in a finished surface, not floating gaps
        well = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        well.add_css_class("pm-well")
        well.set_hexpand(True)

        for i, (label, action, danger, glyph, _keys) in enumerate(ACTIONS):
            if action == "reboot":
                sep = Gtk.Box()
                sep.add_css_class("pm-sep")
                sep.set_hexpand(True)
                well.append(sep)

            btn = self._row(label, action, danger, glyph, i, win)
            self._rows.append(btn)
            self._actions.append(action)
            well.append(btn)

        sheet.append(well)

        hint = Gtk.Label(
            label="↑↓ move   ·   Enter select   ·   Esc cancel",
        )
        hint.add_css_class("pm-hint")
        hint.set_halign(Gtk.Align.CENTER)
        hint.set_wrap(False)
        sheet.append(hint)

        # Clicks on the sheet must not dismiss (claim the sequence).
        stop = Gtk.GestureClick()
        stop.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        stop.connect("pressed", self._on_sheet_press)
        sheet.add_controller(stop)
        overlay.add_overlay(sheet)

        self._apply_css()

        key = Gtk.EventControllerKey()
        key.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        key.connect("key-pressed", self._on_key, win)
        win.add_controller(key)

        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self._dismiss())
        scrim.add_controller(click)

        win.connect("close-request", lambda *_: self._dismiss() or True)

        win.present()
        # Request compositor fullscreen after map (GTK + Hyprland + Sway).
        try:
            win.fullscreen()
        except Exception:
            pass
        GLib.idle_add(self._force_cover)
        GLib.timeout_add(60, self._force_cover)
        GLib.idle_add(self._play_open)
        GLib.idle_add(lambda: self._select(0, focus=True) or False)

        preview_ms = os.environ.get("ETHERIS_POWER_PREVIEW_MS", "").strip()
        if preview_ms.isdigit():
            GLib.timeout_add(int(preview_ms), lambda: self._dismiss() or False)

    @staticmethod
    def _on_sheet_press(gesture, _n, _x, _y) -> bool:
        try:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        except Exception:
            pass
        return True

    def _play_open(self) -> bool:
        if self._sheet and animations_on():
            self._sheet.remove_css_class("eth-glass-enter")
            self._sheet.add_css_class("eth-glass-open")
        if self._scrim and animations_on():
            self._scrim.remove_css_class("eth-scrim-enter")
            self._scrim.add_css_class("eth-scrim-open")
        return False

    def _dismiss(self) -> None:
        if self._closing:
            return
        self._closing = True
        if animations_on() and self._sheet:
            self._sheet.remove_css_class("eth-glass-open")
            self._sheet.add_css_class("eth-glass-leave")
            if self._scrim:
                self._scrim.remove_css_class("eth-scrim-open")
                self._scrim.add_css_class("eth-scrim-leave")
            GLib.timeout_add(close_ms() or 1, lambda: self.quit() or False)
        else:
            self.quit()

    def _row(
        self,
        label: str,
        action: str,
        danger: bool,
        glyph: str,
        index: int,
        win: Gtk.Window,
    ) -> Gtk.Button:
        btn = Gtk.Button()
        btn.add_css_class("flat")
        btn.add_css_class("pm-row")
        if danger:
            btn.add_css_class("pm-row-danger")
        btn.set_hexpand(True)
        btn.set_focusable(True)
        btn.set_can_focus(True)
        try:
            btn.set_cursor(Gdk.Cursor.new_from_name("pointer"))
        except Exception:
            pass
        btn.set_tooltip_text(f"{label}  ·  {glyph}")

        inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        inner.set_hexpand(True)
        inner.add_css_class("pm-row-inner")

        # Accent rail — always present so layout never jumps
        rail = Gtk.Box()
        rail.add_css_class("pm-rail")
        rail.set_valign(Gtk.Align.CENTER)
        rail.set_size_request(3, 16)
        inner.append(rail)

        name = Gtk.Label(label=label)
        name.add_css_class("pm-row-label")
        name.set_hexpand(True)
        name.set_halign(Gtk.Align.START)
        name.set_xalign(0.0)
        name.set_margin_start(12)
        name.set_margin_end(10)
        inner.append(name)

        kbd_box = Gtk.CenterBox()
        kbd_box.add_css_class("pm-row-kbd")
        kbd_box.set_valign(Gtk.Align.CENTER)
        kbd_box.set_size_request(28, 24)
        kbd = Gtk.Label(label=glyph)
        kbd.add_css_class("pm-row-kbd-label")
        kbd.set_halign(Gtk.Align.CENTER)
        kbd_box.set_center_widget(kbd)
        inner.append(kbd_box)

        btn.set_child(inner)
        btn.connect("clicked", self._on_click, action, win)
        btn.connect("notify::has-focus", self._on_row_focus, index)

        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_a, i=index: self._select(i, focus=False))
        btn.add_controller(motion)

        return btn

    def _select(self, index: int, *, focus: bool = True) -> None:
        if self._closing or not self._rows:
            return
        n = len(self._rows)
        index = max(0, min(n - 1, index))
        self._index = index
        for i, btn in enumerate(self._rows):
            if i == index:
                btn.add_css_class("pm-row-active")
            else:
                btn.remove_css_class("pm-row-active")
        if focus:
            self._syncing_focus = True
            try:
                self._rows[index].grab_focus()
            finally:
                self._syncing_focus = False

    def _on_row_focus(self, btn: Gtk.Button, _pspec, index: int) -> None:
        if self._syncing_focus or self._closing:
            return
        if btn.has_focus():
            self._select(index, focus=False)

    def _move(self, delta: int) -> None:
        if self._closing or not self._rows:
            return
        n = len(self._rows)
        self._select((self._index + delta) % n, focus=True)

    def _solid_bg(self) -> Gtk.Box:
        box = Gtk.Box()
        box.add_css_class("solid-bg")
        box.set_hexpand(True)
        box.set_vexpand(True)
        return box

    def _apply_css(self) -> None:
        if PowerMenu._css_loaded:
            return
        display = Gdk.Display.get_default()
        if display is None:
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(
            GLASS_MOTION_CSS
            + b"""
            window {
              background: #0a1628;
            }

            .scrim {
              background: alpha(#020617, 0.48);
            }

            .solid-bg {
              background-image: linear-gradient(
                165deg,
                #040b14 0%,
                #0a1628 38%,
                #0b2238 72%,
                #0a3340 100%
              );
            }

            .pm-sheet {
              padding: 22px 20px 14px 20px;
              border-radius: 22px;
              background: alpha(#0b1a2c, 0.82);
              border: 1px solid alpha(#ffffff, 0.13);
              box-shadow:
                0 28px 80px alpha(#000000, 0.55),
                0 0 0 1px alpha(#38bdf8, 0.05),
                inset 0 1px 0 alpha(#ffffff, 0.14);
            }

            .pm-head {
              margin-bottom: 14px;
