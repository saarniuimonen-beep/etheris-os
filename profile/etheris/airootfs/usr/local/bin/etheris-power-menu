              color: alpha(#e0f2fe, 0.95);
            }

            button.pm-row-danger .pm-row-kbd {
              background: alpha(#fb7185, 0.08);
              border-color: alpha(#fb7185, 0.16);
            }

            button.pm-row-danger .pm-row-kbd-label {
              color: alpha(#fecdd3, 0.70);
            }

            button.pm-row-danger.pm-row-active .pm-row-kbd {
