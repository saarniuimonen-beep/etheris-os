#!/usr/bin/env python3
"""Etheris OS — Session / power menu.

Frosted-glass sheet over a one-shot blurred backdrop (macOS-like).
Lock · Sleep · Log out · Restart · Shut down — calm list, not rainbow tiles.
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Prefer GL for smoother CSS motion when available; cairo remains OK.
if "GSK_RENDERER" not in os.environ:
    os.environ.setdefault("GSK_RENDERER", "cairo")

_LIB = Path(__file__).resolve().parent.parent / "share" / "etheris" / "lib"
if _LIB.is_dir():
    sys.path.insert(0, str(_LIB))

try:
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk
except (ImportError, ValueError) as exc:
    print(f"etheris-power-menu: GTK4/PyGObject required ({exc})", file=sys.stderr)
    print("Falling back is handled by `etheris logout-menu`.", file=sys.stderr)
    sys.exit(2)

from etheris_glass import (  # noqa: E402
    GLASS_MOTION_CSS,
    animations_on,
    close_ms,
    prepare_frosted_backdrop,
)

APP_ID = "os.etheris.PowerMenu"

ACTIONS: list[tuple[str, str, bool, tuple[int, ...]]] = [
    ("Lock", "lock", False, (Gdk.KEY_l, Gdk.KEY_L, Gdk.KEY_1)),
    ("Sleep", "sleep", False, (Gdk.KEY_s, Gdk.KEY_S, Gdk.KEY_2)),
    ("Log out", "logout", False, (Gdk.KEY_o, Gdk.KEY_O, Gdk.KEY_3)),
    ("Restart", "reboot", False, (Gdk.KEY_r, Gdk.KEY_R, Gdk.KEY_4)),
    ("Shut down", "shutdown", True, (Gdk.KEY_d, Gdk.KEY_D, Gdk.KEY_5)),
]


def run_action(action: str) -> None:
    if action == "lock":
        for cmd in (
            ["swaylock", "-f", "-c", "0a1628"],
            ["loginctl", "lock-session"],
        ):
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                continue
    elif action == "sleep":
        subprocess.Popen(["systemctl", "suspend"])
    elif action == "logout":
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
        if "Hyprland" in desktop:
            subprocess.Popen(["hyprctl", "dispatch", "exit"])
        else:
            try:
                subprocess.Popen(["swaymsg", "exit"])
            except OSError:
                subprocess.Popen(
                    ["loginctl", "terminate-user", os.environ.get("USER", "")],
                )
    elif action == "reboot":
        subprocess.Popen(["systemctl", "reboot"])
    elif action == "shutdown":
        subprocess.Popen(["systemctl", "poweroff"])


class PowerMenu(Gtk.Application):
    def __init__(self, backdrop: str | None):
        super().__init__(application_id=APP_ID)
        self.backdrop = backdrop
        self._pending: str | None = None
        self._action_buttons: dict[str, Gtk.Button] = {}
        self._sheet: Gtk.Widget | None = None
        self._scrim: Gtk.Widget | None = None
        self._closing = False

    def do_activate(self) -> None:  # noqa: N802
        wins = self.get_windows()
        if wins:
            self._dismiss()
            return
        self._build()

    def _build(self) -> None:
        win = Gtk.ApplicationWindow(application=self, title="Etheris Session")
        win.set_decorated(False)
        win.set_resizable(False)
        win.maximize()

        overlay = Gtk.Overlay()
        win.set_child(overlay)

        if self.backdrop and os.path.isfile(self.backdrop):
            picture = Gtk.Picture.new_for_filename(self.backdrop)
            picture.set_content_fit(Gtk.ContentFit.COVER)
            picture.set_hexpand(True)
            picture.set_vexpand(True)
            overlay.set_child(picture)
        else:
            overlay.set_child(self._solid_bg())

        scrim = Gtk.Box()
        scrim.add_css_class("scrim")
        if animations_on():
            scrim.add_css_class("eth-scrim-enter")
        else:
            scrim.add_css_class("eth-scrim-open")
        scrim.set_hexpand(True)
        scrim.set_vexpand(True)
        self._scrim = scrim
        overlay.add_overlay(scrim)

        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sheet.set_halign(Gtk.Align.CENTER)
        sheet.set_valign(Gtk.Align.CENTER)
        sheet.add_css_class("pm-sheet")
        sheet.add_css_class("eth-glass-enter" if animations_on() else "eth-glass-open")
        sheet.set_size_request(340, -1)
        self._sheet = sheet

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.add_css_class("pm-head")
        mark = Gtk.Box()
        mark.add_css_class("pm-mark")
        mark.set_size_request(18, 18)
        mark.set_valign(Gtk.Align.CENTER)
        brand = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        word = Gtk.Label(label="Etheris", xalign=0)
        word.add_css_class("pm-brand")
        sub = Gtk.Label(label="Session", xalign=0)
        sub.add_css_class("pm-sub")
        brand.append(word)
        brand.append(sub)
        head.append(mark)
        head.append(brand)
        sheet.append(head)

        list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        list_box.add_css_class("pm-list")
        for label, action, danger, _keys in ACTIONS:
            if action == "reboot":
                sep = Gtk.Box()
                sep.add_css_class("pm-sep")
                sep.set_margin_top(6)
                sep.set_margin_bottom(6)
                list_box.append(sep)
            btn = self._row(label, action, danger, win)
            self._action_buttons[action] = btn
            list_box.append(btn)
        sheet.append(list_box)

        hint = Gtk.Label(label="Esc to cancel  ·  Super+Shift+E")
        hint.add_css_class("pm-hint")
        sheet.append(hint)

        stop = Gtk.GestureClick()
        stop.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        stop.connect("pressed", lambda *_: True)
        sheet.add_controller(stop)
        overlay.add_overlay(sheet)

        self._apply_css()

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self._on_key, win)
        win.add_controller(key)

        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self._dismiss())
        scrim.add_controller(click)

        win.connect("close-request", lambda *_: self._dismiss() or True)

        win.present()
        GLib.idle_add(self._sway_fullscreen)
        GLib.idle_add(self._play_open)
        GLib.idle_add(lambda: self._action_buttons["lock"].grab_focus() or False)

    def _play_open(self) -> bool:
        if self._sheet and animations_on():
            self._sheet.remove_css_class("eth-glass-enter")
            self._sheet.add_css_class("eth-glass-open")
        if self._scrim and animations_on():
            self._scrim.remove_css_class("eth-scrim-enter")
            self._scrim.add_css_class("eth-scrim-open")
        return False

    def _dismiss(self) -> None:
        if self._closing:
            return
        self._closing = True
        if animations_on() and self._sheet:
            self._sheet.remove_css_class("eth-glass-open")
            self._sheet.add_css_class("eth-glass-leave")
            if self._scrim:
                self._scrim.remove_css_class("eth-scrim-open")
                self._scrim.add_css_class("eth-scrim-leave")
            GLib.timeout_add(close_ms() or 1, lambda: self.quit() or False)
        else:
            self.quit()

    def _row(self, label: str, action: str, danger: bool, win: Gtk.Window) -> Gtk.Button:
        btn = Gtk.Button()
        btn.add_css_class("pm-row")
        if danger:
            btn.add_css_class("pm-row-danger")
        btn.set_hexpand(True)
        inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        inner.set_hexpand(True)
        name = Gtk.Label(label=label, xalign=0)
        name.add_css_class("pm-row-label")
        name.set_hexpand(True)
        inner.append(name)
        chev = Gtk.Label(label="›")
        chev.add_css_class("pm-row-chev")
        inner.append(chev)
        btn.set_child(inner)
        btn.connect("clicked", self._on_click, action, win)
        return btn

    def _solid_bg(self) -> Gtk.Box:
        box = Gtk.Box()
        box.add_css_class("solid-bg")
        box.set_hexpand(True)
        box.set_vexpand(True)
        return box

    def _apply_css(self) -> None:
        provider = Gtk.CssProvider()
        provider.load_from_data(
            GLASS_MOTION_CSS
            + b"""
            window { background: #0a1628; }
            .scrim { background: alpha(#020617, 0.32); }
            .solid-bg {
              background-image: linear-gradient(
                160deg, #061018 0%, #0a1628 42%, #0c2744 78%, #0a3a48 100%
              );
            }
            .pm-sheet {
              padding: 22px 20px 18px 20px;
              border-radius: 18px;
              background: alpha(#0c1c30, 0.62);
              border: 1px solid alpha(#ffffff, 0.14);
              box-shadow: 0 24px 64px alpha(#000000, 0.45),
                          inset 0 1px 0 alpha(#ffffff, 0.12);
            }
            .pm-head { margin-bottom: 18px; }
            .pm-mark {
              border-radius: 999px;
              background: #38bdf8;
              border: 2px solid alpha(#7dd3fc, 0.55);
              box-shadow: 0 0 0 3px alpha(#38bdf8, 0.18);
              min-width: 18px; min-height: 18px;
            }
            .pm-brand {
              font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: #e8f4fc;
            }
            .pm-sub {
              font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
              color: alpha(#a8c4d8, 0.9);
            }
            .pm-list { margin-bottom: 14px; }
            .pm-sep { min-height: 1px; background: alpha(#ffffff, 0.10); }
            button.pm-row {
              padding: 13px 14px; border-radius: 12px;
              background: alpha(#ffffff, 0.06);
              border: 1px solid alpha(#ffffff, 0.08);
              color: #e8f4fc;
              transition: 100ms ease;
            }
            button.pm-row:hover, button.pm-row:focus {
              background: alpha(#38bdf8, 0.16);
              border-color: alpha(#38bdf8, 0.40);
            }
            button.pm-row:focus {
              outline: 2px solid alpha(#38bdf8, 0.50);
              outline-offset: 1px;
            }
            button.pm-row-danger { border-color: alpha(#fb7185, 0.30); }
            button.pm-row-danger:hover, button.pm-row-danger:focus {
              background: alpha(#fb7185, 0.18);
              border-color: alpha(#fb7185, 0.50);
            }
            .pm-row-label { font-size: 14px; font-weight: 600; color: #e8f4fc; }
            button.pm-row-danger .pm-row-label { color: #fecdd3; }
            .pm-row-chev { font-size: 16px; color: alpha(#a8c4d8, 0.65); }
            button.pm-row-danger .pm-row-chev { color: alpha(#fb7185, 0.8); }
            .pm-hint { font-size: 11px; color: alpha(#a8c4d8, 0.65); }
            """
        )
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def _sway_fullscreen(self) -> bool:
        try:
            subprocess.Popen(
                ["swaymsg", f'[app_id="{APP_ID}"] fullscreen enable'],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            pass
        return False

    def _on_key(self, _ctrl, keyval, _code, _state, win) -> bool:
        if keyval == Gdk.KEY_Escape:
            self._dismiss()
            return True
        for _label, action, _danger, keys in ACTIONS:
            if keyval in keys:
                self._on_click(None, action, win)
                return True
        return False

    def _on_click(self, _btn, action: str, win: Gtk.Window) -> None:
        self._pending = action
        self.hold()
        self._closing = True
        if animations_on() and self._sheet:
            self._sheet.remove_css_class("eth-glass-open")
            self._sheet.add_css_class("eth-glass-leave")
            if self._scrim:
                self._scrim.remove_css_class("eth-scrim-open")
                self._scrim.add_css_class("eth-scrim-leave")
            GLib.timeout_add(max(close_ms(), 80), self._fire)
        else:
            win.hide()
            GLib.timeout_add(80, self._fire)

    def _fire(self) -> bool:
        if self._pending:
            run_action(self._pending)
            self._pending = None
        try:
            self.release()
        except Exception:
            pass
        self.quit()
        return False


def main() -> int:
    tmp = tempfile.mkdtemp(prefix="etheris-power-")
    backdrop = os.path.join(tmp, "blur.png")
    ok = prepare_frosted_backdrop(backdrop, strength="strong")
    app = PowerMenu(backdrop if ok else None)

    def cleanup(_app=None):
        shutil.rmtree(tmp, ignore_errors=True)

    app.connect("shutdown", cleanup)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
