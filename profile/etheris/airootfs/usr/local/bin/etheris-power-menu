              color: alpha(#ffe4e6, 0.95);
            }

            .pm-hint {
              font-size: 11px;
              font-weight: 500;
              letter-spacing: 0.03em;
              color: alpha(#a8c4d8, 0.72);
              padding: 2px 4px 2px 4px;
            }
            """
        )
        Gtk.StyleContext.add_provider_for_display(
            display,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        PowerMenu._css_loaded = True

    @staticmethod
    def _monitor_size() -> tuple[int, int]:
        display = Gdk.Display.get_default()
        if display is None:
            return 1920, 1080
        mon = None
        try:
            seat = display.get_default_seat()
            pointer = seat.get_pointer() if seat is not None else None
            if pointer is not None:
                found = pointer.get_surface_at_position()
                # GTK 4.10+ returns (surface, x, y); older may differ.
                surface = found[0] if isinstance(found, tuple) else found
                if surface is not None:
                    mon = display.get_monitor_at_surface(surface)
        except Exception:
            mon = None
        if mon is None:
            try:
                monitors = display.get_monitors()
                if monitors.get_n_items() > 0:
                    mon = monitors.get_item(0)
            except Exception:
                mon = None
        if mon is not None:
            try:
                geo = mon.get_geometry()
                return max(int(geo.width), 800), max(int(geo.height), 600)
            except Exception:
                pass
        return 1920, 1080

    def _hypr_our_address(self) -> str | None:
        """Return Hyprland window address for this menu, or None."""
        try:
            raw = subprocess.check_output(
                ["hyprctl", "clients", "-j"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
            for client in json.loads(raw):
                if client.get("class") == APP_ID:
                    addr = client.get("address")
                    if addr:
                        return str(addr)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError, TypeError):
            return None
        return None

    def _force_cover(self) -> bool:
        """Make the host fill the output without compositor chrome."""
        wins = self.get_windows()
        if wins:
            try:
                wins[0].fullscreen()
            except Exception:
                pass

        # Hyprland: only touch fullscreen/chrome if OUR window is identifiable.
        # Never issue a bare fullscreenstate — that can maximize the wrong client.
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            addr = self._hypr_our_address()
            if addr:
                try:
                    subprocess.run(
                        ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
                        check=False,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=2,
                    )
                    # Confirm focus landed on us before mutating fullscreen.
                    active = subprocess.check_output(
                        ["hyprctl", "activewindow", "-j"],
                        text=True,
                        stderr=subprocess.DEVNULL,
                        timeout=2,
                    )
                    if json.loads(active).get("class") == APP_ID:
                        subprocess.run(
                            ["hyprctl", "dispatch", "fullscreenstate", "2", "2"],
                            check=False,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            timeout=2,
                        )
                        for prop, val in (("bordersize", "0"), ("rounding", "0")):
                            subprocess.run(
                                [
                                    "hyprctl",
                                    "dispatch",
                                    "setprop",
                                    f"address:{addr}",
                                    prop,
                                    val,
                                ],
                                check=False,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                timeout=2,
                            )
                except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
                    pass

        # Sway: fullscreen + zero border (matches skel window rules)
        if os.environ.get("SWAYSOCK"):
            try:
                subprocess.run(
                    [
                        "swaymsg",
                        f'[app_id="{APP_ID}"] fullscreen enable, border pixel 0',
                    ],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=2,
                )
            except (OSError, subprocess.SubprocessError):
                pass
        return False

    def _on_key(self, _ctrl, keyval, _code, state, win) -> bool:
        if self._closing:
            return True

        if keyval in (
            Gdk.KEY_Shift_L,
            Gdk.KEY_Shift_R,
            Gdk.KEY_Control_L,
            Gdk.KEY_Control_R,
            Gdk.KEY_Alt_L,
            Gdk.KEY_Alt_R,
            Gdk.KEY_Meta_L,
            Gdk.KEY_Meta_R,
            Gdk.KEY_Super_L,
            Gdk.KEY_Super_R,
            Gdk.KEY_Caps_Lock,
            Gdk.KEY_Num_Lock,
        ):
            return False

        # Esc always cancels, even with modifiers.
        if keyval == Gdk.KEY_Escape:
            self._dismiss()
            return True

        chord = bool(state & _CHORD_MASK)
        # Shift is allowed for letters / Tab; Ctrl/Alt/Super must not fire actions.
        if chord:
            return False

        if keyval in NAV_UP:
            self._move(-1)
            return True

        if keyval in NAV_DOWN:
            self._move(1)
            return True

        if keyval in (Gdk.KEY_Home, Gdk.KEY_KP_Home):
            self._select(0, focus=True)
            return True

        if keyval in (Gdk.KEY_End, Gdk.KEY_KP_End):
            self._select(len(self._rows) - 1, focus=True)
            return True

        if keyval in ACTIVATE:
            if 0 <= self._index < len(self._actions):
                self._on_click(None, self._actions[self._index], win)
            return True

        for i, (_label, action, _danger, _glyph, keys) in enumerate(ACTIONS):
            if keyval in keys:
                self._select(i, focus=True)
                self._on_click(None, action, win)
                return True

        if keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            shift = bool(state & Gdk.ModifierType.SHIFT_MASK) or keyval == Gdk.KEY_ISO_Left_Tab
            self._move(-1 if shift else 1)
            return True

        return False

    def _on_click(self, _btn, action: str, win: Gtk.Window) -> None:
        if self._closing:
            return
        self._pending = action
        if not self._held:
            self.hold()
            self._held = True
        self._closing = True
        if animations_on() and self._sheet:
            self._sheet.remove_css_class("eth-glass-open")
            self._sheet.add_css_class("eth-glass-leave")
            if self._scrim:
                self._scrim.remove_css_class("eth-scrim-open")
                self._scrim.add_css_class("eth-scrim-leave")
            GLib.timeout_add(max(close_ms(), 80), self._fire)
        else:
            try:
                win.hide()
            except Exception:
                pass
            GLib.timeout_add(80, self._fire)

    def _fire(self) -> bool:
        try:
            if self._pending:
                run_action(self._pending)
                self._pending = None
        finally:
            if self._held:
                try:
                    self.release()
                except Exception:
                    pass
                self._held = False
            self.quit()
        return False


def main() -> int:
    tmp = tempfile.mkdtemp(prefix="etheris-power-")
    backdrop = os.path.join(tmp, "blur.png")
    ok = prepare_frosted_backdrop(backdrop, strength="strong")
    app = PowerMenu(backdrop if ok else None)

    def cleanup(_app=None):
        shutil.rmtree(tmp, ignore_errors=True)

    app.connect("shutdown", cleanup)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
