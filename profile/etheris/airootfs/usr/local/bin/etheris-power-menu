            }

            .pm-row-kbd-label {
              font-size: 11px;
              font-weight: 600;
              letter-spacing: 0.02em;
              color: alpha(#a8c4d8, 0.62);
            }

            button.pm-row-active .pm-row-kbd {
              background: alpha(#38bdf8, 0.16);
              border-color: alpha(#38bdf8, 0.30);
            }

