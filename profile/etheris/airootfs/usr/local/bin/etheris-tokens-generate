#!/usr/bin/env python3
"""Generate tokens-dark.conf / tokens-light.conf from etheris.tokens.json.

Stage 1 token bridge — source of truth is the JSON; conf files remain what
etheris-theme-apply loads (stable, shell-friendly). Preserves shipped visual
values (including RADIUS_PANEL=12) so appearance stays continuous.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

DEFAULT_SHARE = Path("/usr/local/share/etheris/design")


def conf_block(variant: str, atm: dict, status: dict, meta: dict, geometry: dict) -> str:
    """Build KEY=VAL conf matching etheris-theme-apply expectations."""
    # Stage 1: keep panel radius at shipped 12 (design JSON may say 14).
    radius_panel = 12
    radius_menu = int(geometry.get("radius", {}).get("menu", 14))
    radius_control = int(geometry.get("radius", {}).get("control", 8))

    bg = atm["bg"]
    bg_el = atm["bgElevated"]
    fg = atm["fg"]
    fg_muted = atm["fgMuted"]
    accent = atm["accent"]
    accent2 = atm["accent2"]
    foot_fg = fg.lstrip("#")
    foot_bg = bg.lstrip("#")
    swaylock = bg_el.lstrip("#") if variant == "light" else bg.lstrip("#")
    # Light focused titlebar uses soft sky (shipped); dark uses elevated.
    if variant == "light":
        sway_focused_bg = "#e0f2fe"
        sway_inactive_border = "#94a3b8"
        foot_alpha = "0.95"
        swaylock = "e0f2fe"
    else:
        sway_focused_bg = bg_el
        sway_inactive_border = "#1e3a5f"
        foot_alpha = "0.92"

    lines = [
        f"# Generated by etheris-tokens-generate from etheris.tokens.json",
        f"# Atmosphere base: {atm.get('label', variant)} — do not hand-edit; regenerate instead.",
        f"VARIANT={variant}",
        f"BG={bg}",
        f"BG_ELEVATED={bg_el}",
        f"BG_DEEP={atm.get('bgDeep', bg)}",
        f"BG_PANEL_RGBA={atm['panel']}",
        f"BG_MENU_RGBA={atm['menu']}",
        f"BG_INPUT_RGBA={atm['input']}",
        f"FG={fg}",
        f"FG_MUTED={fg_muted}",
        f"FG_SUBTLE={atm.get('fgSubtle', fg_muted)}",
        f"ACCENT={accent}",
        f"ACCENT_2={accent2}",
        f"ACCENT_SOFT_RGBA={atm['accentSoft']}",
        f"BORDER_RGBA={atm['border']}",
        f"SUCCESS={status['success']}",
        f"WARNING={status['warning']}",
        f"DANGER={status['danger']}",
        f"FOCUS={atm['focus']}",
        f"HIGHLIGHT={atm.get('highlight', 'rgba(255,255,255,0.12)')}",
        f"GTK_THEME={atm.get('gtkTheme', 'Adwaita-dark' if variant == 'dark' else 'Adwaita')}",
        f"ICON_THEME={atm.get('iconTheme', 'Papirus-Dark' if variant == 'dark' else 'Papirus')}",
        f"FONT_UI={meta.get('fontUi', 'Outfit')}",
        f"FONT_MONO={meta.get('fontMono', 'JetBrains Mono')}",
        f"SWAY_FOCUSED_BORDER={accent}",
        f"SWAY_FOCUSED_BG={sway_focused_bg}",
        f"SWAY_FOCUSED_TEXT={fg}",
        f"SWAY_FOCUSED_INDICATOR={accent2}",
        f"SWAY_INACTIVE_BORDER={sway_inactive_border}",
        f"SWAY_INACTIVE_BG={bg}",
        f"SWAY_INACTIVE_TEXT={fg_muted}",
        f"SWAYLOCK_COLOR={swaylock}",
        f"FOOT_FG={foot_fg}",
        f"FOOT_BG={foot_bg}",
        f"FOOT_ALPHA={foot_alpha}",
        f"RADIUS_PANEL={radius_panel}",
        f"RADIUS_MENU={radius_menu}",
        f"RADIUS_CONTROL={radius_control}",
        "",
    ]
    return "\n".join(lines)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument(
        "--design-dir",
        type=Path,
        default=None,
        help="Directory containing etheris.tokens.json (default: $ETHERIS_SHARE/design or system path)",
    )
    ap.add_argument("--check", action="store_true", help="Verify JSON parses; print paths; do not write")
    args = ap.parse_args()

    share = Path(__import__("os").environ.get("ETHERIS_SHARE", "/usr/local/share/etheris"))
    design = args.design_dir or (share / "design")
    if not design.is_dir():
        design = DEFAULT_SHARE

    src = design / "etheris.tokens.json"
    if not src.is_file():
        print(f"etheris-tokens-generate: missing {src}", file=sys.stderr)
        return 1

    data = json.loads(src.read_text(encoding="utf-8"))
    atmospheres = data["atmospheres"]
    status = data["semanticStatus"]
    meta = data.get("meta", {})
    geometry = data.get("geometry", {})

    dark_atm = atmospheres["ocean-glass"]
    light_atm = atmospheres["arctic-glow"]

    dark_conf = conf_block("dark", dark_atm, status["dark"], meta, geometry)
    light_conf = conf_block("light", light_atm, status["light"], meta, geometry)

    out_dark = design / "tokens-dark.conf"
    out_light = design / "tokens-light.conf"

    if args.check:
        print(f"ok json={src}")
        print(f"would_write {out_dark}")
        print(f"would_write {out_light}")
        return 0

    out_dark.write_text(dark_conf, encoding="utf-8")
    out_light.write_text(light_conf, encoding="utf-8")
    print(f"etheris-tokens-generate: wrote {out_dark}")
    print(f"etheris-tokens-generate: wrote {out_light}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
