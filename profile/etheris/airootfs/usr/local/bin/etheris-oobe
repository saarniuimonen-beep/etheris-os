#!/usr/bin/env bash
# Etheris OS — branded first-boot setup (OOBE) for *installed* systems only.
# Spec: /usr/local/share/etheris/docs/OOBE.md (and docs/OOBE.md in the tree)
set -euo pipefail

STATE_DIR="${ETHERIS_OOBE_DIR:-/var/lib/etheris/oobe}"
STATE_FILE="$STATE_DIR/state"
DRAFT_FILE="$STATE_DIR/draft.conf"
CONF_FILE="${ETHERIS_OOBE_CONF:-/etc/etheris/oobe.conf}"
SHARE="${ETHERIS_SHARE:-/usr/local/share/etheris}"

is_live() {
  [[ -d /run/archiso ]] || [[ -f /run/archiso/bootmnt ]]
}

conf_get() {
  local key="$1" def="${2:-}"
  if [[ -f "$CONF_FILE" ]]; then
    local v
    v="$(grep -E "^${key}=" "$CONF_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    [[ -n "$v" ]] && { echo "$v"; return; }
  fi
  echo "$def"
}

state_read() {
  # User "done" wins so a completed wizard isn't re-run if system state stayed needed.
  if [[ -f "$USER_STATE_DIR/state" ]]; then
    local us
    us="$(tr -d '[:space:]' <"$USER_STATE_DIR/state")"
    [[ "$us" == "done" ]] && { echo "done"; return; }
  fi
  if [[ -f "$STATE_FILE" ]]; then
    tr -d '[:space:]' <"$STATE_FILE"
    return
  fi
  echo ""
}

# Prefer system state dir; if not writable (no password prompts!), fall back to user dir.
USER_STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/etheris/oobe"

resolve_writable_state() {
  if [[ -d "$STATE_DIR" && -w "$STATE_DIR" ]]; then
    return 0
  fi
  if [[ -w "$STATE_FILE" ]]; then
    return 0
  fi
  # Non-interactive only — never prompt during OOBE UI
  if sudo -n chmod 777 "$STATE_DIR" 2>/dev/null; then
    sudo -n chmod 666 "$STATE_FILE" 2>/dev/null || true
  fi
  if [[ -d "$STATE_DIR" && -w "$STATE_DIR" ]]; then
    return 0
  fi
  STATE_DIR="$USER_STATE_DIR"
  STATE_FILE="$STATE_DIR/state"
  DRAFT_FILE="$STATE_DIR/draft.conf"
  mkdir -p "$STATE_DIR"
}

state_write() {
  local s="$1"
  resolve_writable_state
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$s" >"$STATE_FILE"
  # Mirror into system path when possible so session gate sees "done"
  if [[ "$STATE_FILE" != /var/lib/etheris/oobe/state ]]; then
    if [[ -w /var/lib/etheris/oobe/state ]] 2>/dev/null; then
      printf '%s\n' "$s" >/var/lib/etheris/oobe/state || true
    elif sudo -n true 2>/dev/null; then
      printf '%s\n' "$s" | sudo -n tee /var/lib/etheris/oobe/state >/dev/null || true
    fi
  fi
}

draft_set() {
  local key="$1" val="$2"
  resolve_writable_state
  mkdir -p "$STATE_DIR"
  touch "$DRAFT_FILE"
  if grep -qE "^${key}=" "$DRAFT_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$DRAFT_FILE"
  else
    echo "${key}=${val}" >>"$DRAFT_FILE"
  fi
}

draft_get() {
  local key="$1" def="${2:-}"
  [[ -f "$DRAFT_FILE" ]] || { echo "$def"; return; }
  local v
  v="$(grep -E "^${key}=" "$DRAFT_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  [[ -n "$v" ]] && echo "$v" || echo "$def"
}

oobe_should_run() {
  is_live && return 1
  [[ "$(conf_get enabled 1)" == "1" ]] || return 1
  local st
  st="$(state_read)"
  [[ "$st" == "needed" || "$st" == "in_progress" ]]
}

cmd_status() {
  echo "live=$(is_live && echo yes || echo no)"
  echo "enabled=$(conf_get enabled 1)"
  echo "state=$(state_read || echo unset)"
  echo "state_file=$STATE_FILE"
  if oobe_should_run; then
    echo "action=run"
  else
    echo "action=skip"
  fi
}

# --- Apply helpers (idempotent; no passwords in draft) ---

apply_keyboard() {
  local layout="$1" variant="${2:-}"
  [[ -n "$layout" ]] || return 0
  # Console (optional; never prompt)
  local tmp
  tmp="$(mktemp)"
  {
    echo "KEYMAP=${layout}"
    [[ -n "$variant" ]] && echo "# XKBVARIANT=${variant}"
  } >"$tmp"
  if [[ -w /etc/vconsole.conf ]]; then
    cp "$tmp" /etc/vconsole.conf || true
  elif sudo -n true 2>/dev/null; then
    sudo -n cp "$tmp" /etc/vconsole.conf 2>/dev/null || true
  fi
  rm -f "$tmp"
  # User Sway / XKB (always writable)
  local sway_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
  mkdir -p "$sway_dir/config.d"
  {
    echo "# Generated by etheris-oobe — keyboard"
    echo "input type:keyboard {"
    echo "    xkb_layout ${layout}"
    [[ -n "$variant" ]] && echo "    xkb_variant ${variant}"
    echo "}"
  } >"$sway_dir/config.d/10-keyboard.conf"
  if [[ -f "$sway_dir/config" ]] && ! grep -q 'config.d' "$sway_dir/config" 2>/dev/null; then
    printf '\ninclude %s/config.d/*\n' "$sway_dir" >>"$sway_dir/config"
  fi
  if command -v localectl >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    if [[ -n "$variant" ]]; then
      sudo -n localectl set-x11-keymap "$layout" "" "$variant" 2>/dev/null || true
    else
      sudo -n localectl set-x11-keymap "$layout" 2>/dev/null || true
    fi
    sudo -n localectl set-keymap "$layout" 2>/dev/null || true
  fi
}

apply_appearance() {
  local theme="$1"
  [[ -n "$theme" ]] || return 0
  if command -v etheris >/dev/null 2>&1; then
    etheris theme "$theme" 2>/dev/null || true
  fi
}

apply_all() {
  local kb theme
  kb="$(draft_get keyboard us)"
  theme="$(draft_get theme mist)"
  apply_keyboard "$kb" "$(draft_get keyboard_variant "")"
  apply_appearance "$theme"
  # Privacy stays at defaults; wizard only confirms
  mkdir -p /etc/etheris 2>/dev/null || true
}

finish_and_desktop() {
  state_write "done"
  clear
  cat <<'EOF'

  Setup complete.

  Log in again to start the Etheris desktop
  (OOBE will not run a second time).

EOF
  sleep 1.2
  if [[ "${ETHERIS_OOBE_SESSION:-0}" == "1" ]] \
    && [[ -n "${SWAYSOCK:-}" ]] \
    && command -v swaymsg >/dev/null 2>&1; then
    swaymsg exit 2>/dev/null || true
    exit 0
  fi
  exit 0
}

pause() {
  echo
  read -r -p "  Press Enter to continue… " _
}

page_welcome() {
  clear
  cat <<'EOF'

  Etheris OS — first-time setup

  A few settings the installer does not ask for.
  Account, hostname, locale, and timezone are already set
  (review only). You can finish fully offline.

EOF
  pause
}

page_account_summary() {
  clear
  echo
  echo "  Account & system (already configured)"
  echo
  echo "  User:     $(id -un 2>/dev/null || echo unknown)"
  echo "  Hostname: $(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo unknown)"
  echo "  Locale:   $(grep -E '^LANG=' /etc/locale.conf 2>/dev/null | cut -d= -f2- || echo unknown)"
  echo "  Timezone: $(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || echo unknown)"
  echo
  echo "  No second account is created here."
  pause
}

page_keyboard() {
  [[ "$(conf_get page_keyboard 1)" == "1" ]] || return 0
  clear
  echo
  echo "  Keyboard layout"
  echo
  echo "  Common choices:"
  echo "    1) us          (US QWERTY)"
  echo "    2) uk          (UK)"
  echo "    3) de          (German)"
  echo "    4) fr          (French)"
  echo "    5) se          (Swedish)"
  echo "    6) fi          (Finnish)"
  echo "    7) Keep current / skip"
  echo
  local choice layout
  layout="$(draft_get keyboard us)"
  read -r -p "  Choice [1-7] (default 1): " choice || true
  case "${choice:-1}" in
    1) layout=us ;;
    2) layout=uk ;;
    3) layout=de ;;
    4) layout=fr ;;
    5) layout=se ;;
    6) layout=fi ;;
    7) echo "  Skipping keyboard change."; pause; return 0 ;;
    *) layout=us ;;
  esac
  draft_set keyboard "$layout"
  echo "  Selected: $layout"
  pause
}

page_network() {
  [[ "$(conf_get page_network 1)" == "1" ]] || return 0
  clear
  echo
  echo "  Network"
  echo
  if command -v nmcli >/dev/null 2>&1; then
    nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null | sed 's/^/  /' || true
  else
    echo "  NetworkManager tools not available in this session."
  fi
  echo
  echo "  Wi-Fi can be configured later with: nmtui  or  nmcli"
  echo "  Offline setup is fully supported."
  echo
  echo "    1) Continue offline / skip"
  echo "    2) Open nmtui now (optional)"
  local choice
  read -r -p "  Choice [1-2] (default 1): " choice || true
  if [[ "${choice:-1}" == "2" ]] && command -v nmtui >/dev/null 2>&1; then
    nmtui || true
  fi
}

page_appearance() {
  [[ "$(conf_get page_appearance 1)" == "1" ]] || return 0
  clear
  echo
  echo "  Appearance"
  echo
  local themes=()
  local t
  if [[ -d "$SHARE/themes" ]]; then
    while IFS= read -r t; do
      themes+=("$(basename "$t" .theme)")
    done < <(find "$SHARE/themes" -maxdepth 1 -name '*.theme' | sort)
  fi
  if [[ ${#themes[@]} -eq 0 ]]; then
    themes=(mist)
  fi
  local i=1
  for t in "${themes[@]}"; do
    echo "    $i) $t"
    i=$((i + 1))
  done
  echo "    $i) Skip"
  echo
  local choice idx
  read -r -p "  Choice [1-$i] (default 1): " choice || true
  choice="${choice:-1}"
  if [[ "$choice" == "$i" ]]; then
    pause
    return 0
  fi
  idx=$((choice - 1))
  if [[ $idx -ge 0 && $idx -lt ${#themes[@]} ]]; then
    draft_set theme "${themes[$idx]}"
    echo "  Theme: ${themes[$idx]}"
  fi
  pause
}

page_privacy() {
  [[ "$(conf_get page_privacy 1)" == "1" ]] || return 0
  clear
  echo
  echo "  Privacy"
  echo
  if [[ -f /etc/etheris/privacy.conf ]]; then
    sed 's/^/  /' /etc/etheris/privacy.conf
  else
    echo "  Defaults: no telemetry / analytics / crash upload."
  fi
  echo
  echo "  These stay private by default. No account is required."
  pause
}

page_review() {
  clear
  echo
  echo "  Review"
  echo
  echo "  Keyboard:  $(draft_get keyboard us)"
  echo "  Theme:     $(draft_get theme mist)"
  echo "  Privacy:   defaults kept"
  echo
  echo "    1) Apply & finish"
  echo "    2) Back to keyboard"
  local choice
  read -r -p "  Choice [1-2] (default 1): " choice || true
  case "${choice:-1}" in
    2) page_keyboard; page_review ;;
    *) return 0 ;;
  esac
}

cmd_run() {
  if is_live; then
    echo "OOBE does not run on the live ISO." >&2
    exit 0
  fi
  if [[ "$(conf_get enabled 1)" != "1" ]]; then
    echo "OOBE disabled in $CONF_FILE" >&2
    exit 0
  fi
  local st
  st="$(state_read)"
  if [[ "$st" == "done" ]]; then
    echo "OOBE already completed." >&2
    exit 0
  fi
  if [[ "$st" != "needed" && "$st" != "in_progress" ]]; then
    echo "OOBE state is '$st' (not needed). Use: etheris-oobe mark needed" >&2
    exit 0
  fi

  state_write "in_progress"
  page_welcome
  page_account_summary
  page_keyboard
  page_network
  page_appearance
  page_privacy
  page_review

  echo
  echo "  Applying…"
  apply_all
  echo "  Done."
  sleep 0.6
  finish_and_desktop
}

cmd_maybe_run() {
  # Called from normal sway autostart (fallback if session gate unused)
  oobe_should_run || exit 0
  if ! command -v foot >/dev/null 2>&1; then
    exit 0
  fi
  foot -T "Etheris OS setup" -a etheris-oobe etheris-oobe run
}

cmd_mark() {
  local s="${1:-}"
  case "$s" in
    needed|in_progress|done|disabled)
      state_write "$s"
      echo "state=$s"
      ;;
    *)
      echo "Usage: etheris-oobe mark needed|in_progress|done|disabled" >&2
      exit 1
      ;;
  esac
}

cmd_help() {
  cat <<'EOF'
Etheris OS — first-boot setup (OOBE)

  etheris-oobe status
  etheris-oobe run           Interactive wizard (installed systems)
  etheris-oobe maybe-run     No-op unless state is needed/in_progress
  etheris-oobe mark <state>  needed|in_progress|done|disabled

Never runs on the live ISO. Passwords are never written to draft files.
EOF
}

main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    status) cmd_status ;;
    run) cmd_run ;;
    maybe-run|maybe) cmd_maybe_run ;;
    mark) cmd_mark "${1:-}" ;;
    help|-h|--help) cmd_help ;;
    *) cmd_help; exit 1 ;;
  esac
}

main "$@"
