#!/usr/bin/env python3
"""Etheris OS — lightweight window motion on Sway (WP-S4).

Stock Sway has no Genie/macOS effects. We only do cheap opacity ramps on
window map via IPC, and no-op when animations=off / reduced motion.

Never replaces the compositor. Safe to kill; windows remain usable.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time

SETTINGS = os.path.expanduser("~/.config/etheris/settings.conf")


def setting(key: str, default: str = "") -> str:
    if not os.path.isfile(SETTINGS):
        return default
    try:
        with open(SETTINGS, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith(f"{key}="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        return default
    return default


def motion_enabled() -> bool:
    env = os.environ.get("ETHERIS_MOTION", "").strip()
    if env == "0":
        return False
    if env == "1":
        return True
    anim = setting("animations", "on").lower()
    return anim not in {"off", "0", "false", "reduced", "reduce"}


def sway_args(*args: str) -> None:
    try:
        subprocess.run(
            ["swaymsg", "--", *args],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1.5,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def fade_in(con_id: int, steps: int = 5, total_ms: int = 100) -> None:
    """Opacity ramp — keep short to avoid feeling laggy."""
    if con_id <= 0:
        return
    delay = max(total_ms / steps, 1) / 1000.0
    for i in range(1, steps + 1):
        op = round(0.2 + 0.8 * (i / steps), 3)
        sway_args(f"[con_id={con_id}]", "opacity", str(op))
        time.sleep(delay)


def main() -> int:
    if not motion_enabled():
        # Stay alive but idle so sway exec isn't a crash-loop; exit quietly
        # so users with animations=off don't pay for a subscriber.
        return 0

    try:
        proc = subprocess.Popen(
            ["swaymsg", "-m", "-t", "subscribe", '["window"]'],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError as exc:
        print(f"etheris-motion: cannot subscribe ({exc})", file=sys.stderr)
        return 1

    assert proc.stdout is not None
    for line in proc.stdout:
        if not motion_enabled():
            continue
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        if ev.get("change") != "new":
            continue
        container = ev.get("container") or {}
        # Skip floating layer shells / non-toplevel when possible
        if container.get("type") not in (None, "con", "floating_con"):
            continue
        cid = int(container.get("id") or 0)
        app = (container.get("app_id") or container.get("window_properties", {}).get("class") or "")
        # Avoid animating the shell itself if it emits events
        if app in {"waybar", "wofi", "mako"}:
            continue
        try:
            sway_args(f"[con_id={cid}]", "opacity", "0.2")
            fade_in(cid)
        except Exception:
            # Never take down the session for motion glitches
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
