#!/usr/bin/env bash
# Etheris OS — persist Wayland display layout across reboots (Sway outputs).
#   etheris-display save     Write current outputs → ~/.config/sway/config.d/50-outputs.conf
#   etheris-display show     Print saved or current layout
#   etheris-display apply    Reload Sway config (after save)
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d"
OUT="$CONF_DIR/50-outputs.conf"

cmd="${1:-show}"

save_outputs() {
  command -v swaymsg >/dev/null 2>&1 || {
    echo "etheris-display: swaymsg not available (not in a Sway session?)" >&2
    return 1
  }
  command -v jq >/dev/null 2>&1 || {
    echo "etheris-display: jq required" >&2
    return 1
  }
  mkdir -p "$CONF_DIR"
  local json
  json="$(swaymsg -t get_outputs)"
  {
    echo "# Generated by etheris-display save — survives reboot"
    echo "# Re-run: etheris-display save"
    echo "$json" | jq -r '
      .[]
      | select(.active == true)
      | "# \(.name) \(.make // "") \(.model // "")",
        "output \(.name) {",
        (if .current_mode then
          "    mode \(.current_mode.width)x\(.current_mode.height)@\(.current_mode.refresh / 1000)Hz"
         else empty end),
        (if .scale then "    scale \(.scale)" else empty end),
        (if .transform and .transform != "normal" then "    transform \(.transform)" else empty end),
        (if (.rect.x != 0 or .rect.y != 0) then
          "    position \(.rect.x) \(.rect.y)"
         else empty end),
        "}"
    '
  } >"$OUT"
  echo "etheris-display: saved → $OUT"
  cat "$OUT"
}

show_outputs() {
  if [[ -f "$OUT" ]]; then
    echo "# saved ($OUT)"
    cat "$OUT"
  else
    echo "# no saved layout yet — run: etheris-display save"
  fi
  if command -v swaymsg >/dev/null 2>&1; then
    echo "# current"
    swaymsg -t get_outputs | jq -r '.[] | "\(.name): \(.current_mode.width // "?")x\(.current_mode.height // "?") scale=\(.scale) pos=\(.rect.x),\(.rect.y) active=\(.active)"' 2>/dev/null || true
  fi
}

apply_outputs() {
  [[ -f "$OUT" ]] || { echo "etheris-display: nothing saved"; return 1; }
  if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg >/dev/null 2>&1; then
    swaymsg reload
    echo "etheris-display: sway reloaded"
  else
    echo "etheris-display: saved; will apply on next Sway start"
  fi
}

case "$cmd" in
  save) save_outputs ;;
  show|status) show_outputs ;;
  apply) apply_outputs ;;
  -h|--help)
    echo "Usage: etheris-display save|show|apply"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 2
    ;;
esac
