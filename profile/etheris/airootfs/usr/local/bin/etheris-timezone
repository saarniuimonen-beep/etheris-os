#!/usr/bin/env python3
"""Etheris OS — first-login timezone picker with a 3D globe (WebKit + Three.js)."""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote

os.environ.setdefault("GSK_RENDERER", "cairo")

SHARE = Path(os.environ.get("ETHERIS_SHARE", "/usr/local/share/etheris"))
TZ_SHARE = SHARE / "timezone"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "etheris"
FLAG = CONF / "timezone-done"
ZONE_TAB = Path("/usr/share/zoneinfo/zone1970.tab")
ZONE_TAB_ALT = Path("/usr/share/zoneinfo/zone.tab")

COORD_RE = re.compile(
    r"^(?P<lat_sign>[+-])(?P<lat>\d{2})(?P<latm>\d{2})(?P<lats>\d{2})?"
    r"(?P<lon_sign>[+-])(?P<lon>\d{3})(?P<lonm>\d{2})(?P<lons>\d{2})?$"
)


def parse_coord(raw: str) -> tuple[float, float] | None:
    m = COORD_RE.match(raw.strip())
    if not m:
        return None
    lat = int(m.group("lat")) + int(m.group("latm")) / 60.0
    if m.group("lats"):
        lat += int(m.group("lats")) / 3600.0
    lon = int(m.group("lon")) + int(m.group("lonm")) / 60.0
    if m.group("lons"):
        lon += int(m.group("lons")) / 3600.0
    if m.group("lat_sign") == "-":
        lat = -lat
    if m.group("lon_sign") == "-":
        lon = -lon
    return lat, lon


def pretty_name(tz: str, comment: str) -> str:
    # Prefer the zone path city ("Tokyo", "New York") — zone1970 comments are
    # often multi-country blurbs or obscure observatory names.
    base = tz.split("/")[-1].replace("_", " ")
    if base and base.upper() != "UTC":
        return base
    if comment:
        return comment.split(",")[0].strip() or tz
    return tz


def load_cities() -> list[dict]:
    path = ZONE_TAB if ZONE_TAB.is_file() else ZONE_TAB_ALT
    cities: list[dict] = []
    seen: set[str] = set()
    if not path.is_file():
        return cities
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        country, coord, tz = parts[0], parts[1], parts[2]
        comment = parts[3] if len(parts) > 3 else ""
        parsed = parse_coord(coord)
        if not parsed:
            continue
        lat, lon = parsed
        key = f"{tz}|{lat:.3f}|{lon:.3f}"
        if key in seen:
            continue
        seen.add(key)
        primary_cc = (country.split(",")[0] or "").strip().upper()
        cities.append(
            {
                "name": pretty_name(tz, comment),
                "tz": tz,
                "lat": round(lat, 4),
                "lon": round(lon, 4),
                "country": primary_cc,
                "countries": country,
            }
        )
    cities.sort(key=lambda c: (c["name"].lower(), c["tz"]))
    # Pin common hubs near the top so first-login isn't a scroll marathon.
    pin = {
        "Europe/Helsinki",
        "Europe/London",
        "Europe/Berlin",
        "Europe/Paris",
        "America/New_York",
        "America/Los_Angeles",
        "America/Chicago",
        "Asia/Tokyo",
        "Asia/Shanghai",
        "Asia/Singapore",
        "Australia/Sydney",
        "UTC",
    }
    pinned = [c for c in cities if c["tz"] in pin]
    rest = [c for c in cities if c["tz"] not in pin]
    return pinned + rest


def already_done() -> bool:
    return FLAG.is_file()


def mark_done() -> None:
    CONF.mkdir(parents=True, exist_ok=True)
    FLAG.write_text("done\n", encoding="utf-8")


def set_settings(**values: str) -> None:
    CONF.mkdir(parents=True, exist_ok=True)
    settings = CONF / "settings.conf"
    data: dict[str, str] = {}
    order: list[str] = []
    if settings.is_file():
        for line in settings.read_text(encoding="utf-8").splitlines():
            if not line.strip() or line.strip().startswith("#") or "=" not in line:
                order.append(line)
                continue
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip()
            order.append(k.strip())
    for k, v in values.items():
        if k not in data:
            order.append(k)
        data[k] = v
    out: list[str] = []
    seen: set[str] = set()
    for item in order:
        if "=" not in item and item not in data:
            out.append(item)
            continue
        key = item.split("=", 1)[0] if "=" in item else item
        if key in seen or key not in data:
            continue
        out.append(f"{key}={data[key]}")
        seen.add(key)
    for k, v in data.items():
        if k not in seen:
            out.append(f"{k}={v}")
    settings.write_text("\n".join(out) + "\n", encoding="utf-8")


def apply_timezone(tz: str, *, country: str = "", auto: bool | None = None) -> None:
    zone = Path("/usr/share/zoneinfo") / tz
    if not zone.exists():
        raise SystemExit(f"unknown timezone: {tz}")
    for cmd in (
        ["timedatectl", "set-timezone", tz],
        ["timedatectl", "set-ntp", "true"],
    ):
        try:
            subprocess.run(cmd, check=True)
        except (subprocess.CalledProcessError, FileNotFoundError):
            subprocess.run(["sudo", "-n", *cmd], check=False)

    payload: dict[str, str] = {"timezone": tz}
    if country:
        payload["timezone_country"] = country.upper()
    if auto is not None:
        payload["timezone_auto"] = "on" if auto else "off"
    set_settings(**payload)


def prepare_runtime(cities: list[dict]) -> Path:
    runtime = Path(tempfile.mkdtemp(prefix="etheris-timezone-"))
    for name in ("index.html", "style.css", "app.js", "three.min.js", "earth.jpg"):
        src = TZ_SHARE / name
        if src.is_file():
            shutil.copy2(src, runtime / name)
    (runtime / "cities.js").write_text(
        "window.ETHERIS_CITIES = " + json.dumps(cities, ensure_ascii=False) + ";\n",
        encoding="utf-8",
    )
    return runtime


class _QuietHandler(SimpleHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:  # noqa: A003
        return


def start_http(runtime: Path) -> tuple[ThreadingHTTPServer, str]:
    handler = partial(_QuietHandler, directory=str(runtime))
    server = ThreadingHTTPServer(("127.0.0.1", 0), handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    host, port = server.server_address[:2]
    return server, f"http://{host}:{port}/index.html"


