#!/usr/bin/env bash
# Etheris OS — aggregate diagnostics for support / smoke.
# Exit 0 when all hard checks pass; 1 if any hard check fails; 2 on usage error.
set -euo pipefail

usage() {
  cat <<'EOF'
Etheris doctor — local health aggregator

Usage:
  etheris doctor           Run full checklist
  etheris doctor --json    Machine-readable summary (stdout)
  etheris doctor help

Runs (best-effort):
  • etheris-auth-check
  • etheris-security audit
  • failed / degraded systemd units
  • nftables active?
  • greeter seed / skip_selection presence
  • session desktop files
EOF
}

ok=0
fail=0
warn=0
pass() { echo "  OK  $*"; ok=$((ok + 1)); }
bad() { echo "FAIL  $*"; fail=$((fail + 1)); }
note() { echo "WARN $*"; warn=$((warn + 1)); }

section() { echo; echo "==> $*"; }

run_auth() {
  section "Authentication (etheris-auth-check)"
  if ! command -v etheris-auth-check >/dev/null 2>&1; then
    bad "etheris-auth-check missing"
    return
  fi
  set +e
  out="$(etheris-auth-check 2>&1)"
  rc=$?
  set -e
  echo "$out" | sed 's/^/  | /'
  if ((rc == 0)); then
    pass "auth-check exit 0"
  else
    bad "auth-check exit $rc"
  fi
}

run_security() {
  section "Security checklist (etheris-security audit)"
  if ! command -v etheris-security >/dev/null 2>&1; then
    bad "etheris-security missing"
    return
  fi
  set +e
  out="$(etheris-security audit 2>&1)"
  rc=$?
  set -e
  echo "$out" | sed 's/^/  | /'
  if ((rc == 0)); then
    pass "security audit exit 0"
  else
    bad "security audit exit $rc"
  fi
}

# Units that fail harmlessly in QEMU/live (CDROM/optical loop attach) — WARN only.
# Real unit names look like systemd-loop@sys-devices-pci…ata…service (often no "sr0" token).
is_benign_failed_unit() {
  local u="$1"
  case "$u" in
    systemd-loop@*) return 0 ;;
  esac
  return 1
}

run_units() {
  section "Systemd failed / degraded"
  local failed degraded line unit product=0
  failed="$(systemctl --failed --no-legend --no-pager --plain 2>/dev/null || true)"
  if [[ -z "${failed// }" ]]; then
    pass "no failed units"
  else
    while IFS= read -r line; do
      [[ -z "${line// }" ]] && continue
      unit="$(awk '{print $1}' <<<"$line")"
      echo "  | $line"
      if is_benign_failed_unit "$unit"; then
        note "ignoring benign VM/CDROM unit: $unit"
      else
        product=1
      fi
    done <<<"$failed"
    if ((product)); then
      bad "product-relevant failed units present"
    else
      pass "no product-relevant failed units (benign VM noise only)"
    fi
  fi
  degraded="$(systemctl is-system-running 2>/dev/null || true)"
  case "$degraded" in
    running) pass "systemctl is-system-running: running" ;;
    degraded)
      if ((product)); then
        note "systemctl is-system-running: degraded (inspect --failed)"
      else
        note "systemctl is-system-running: degraded (benign units only)"
      fi
      ;;
    *)
      note "systemctl is-system-running: ${degraded:-unknown}"
      ;;
  esac
}

run_firewall() {
  section "Firewall"
  if systemctl is-active --quiet nftables 2>/dev/null; then
    pass "nftables active"
  elif systemctl is-enabled --quiet nftables 2>/dev/null; then
    note "nftables enabled but not active in this context"
  else
    bad "nftables not active/enabled"
  fi
}

run_greeter() {
  section "Greeter / session"
  if [[ -f /etc/greetd/regreet.toml ]] && grep -qE '^\s*skip_selection\s*=\s*true' /etc/greetd/regreet.toml; then
    pass "skip_selection=true"
  else
    bad "regreet skip_selection not true"
  fi
  if [[ -f /var/lib/regreet/state.toml ]] \
    && grep -qE 'last_user\s*=' /var/lib/regreet/state.toml; then
    if grep -qF 'Etheris (Sway)' /var/lib/regreet/state.toml; then
      pass "regreet state.toml present (Etheris session)"
    else
      note "regreet state.toml present but Etheris (Sway) mapping missing"
    fi
  else
    note "regreet state.toml missing (cold skip_selection may show User/Session)"
  fi
  if [[ -f /usr/share/wayland-sessions/etheris.desktop ]]; then
    pass "etheris.desktop present"
  else
    bad "etheris.desktop missing"
  fi
  if [[ -f /usr/share/wayland-sessions/sway.desktop ]]; then
    if grep -qiE '^(Hidden|NoDisplay)=true' /usr/share/wayland-sessions/sway.desktop; then
      pass "stock sway.desktop hidden"
    else
      bad "stock sway.desktop visible in greeter"
    fi
  else
    pass "stock sway.desktop absent"
  fi
}

run_session_hint() {
  section "Desktop session"
  echo "  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
  echo "  XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
  echo "  XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-}"
  if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    pass "graphical session env present"
  else
    note "not in a graphical session (TTY/SSH is fine for auth/security)"
  fi
}

run_tooling() {
  section "Etheris tooling"
  local bin
  for bin in etheris-packages etheris-privacy etheris-report etheris-software-center etheris-monitor etheris-profiles; do
    if [[ -x "/usr/local/bin/$bin" ]]; then
      pass "$bin present"
    else
      bad "$bin missing"
    fi
  done
  if [[ -f /usr/local/share/etheris/groups/gaming.list ]]; then
    pass "package groups present"
  else
    bad "package groups missing"
  fi
}

run_connectivity() {
  section "Audio / network / Bluetooth"
  if systemctl is-active --quiet NetworkManager 2>/dev/null; then
    pass "NetworkManager active"
  else
    bad "NetworkManager not active"
  fi
  if systemctl is-enabled --quiet iwd 2>/dev/null || systemctl is-active --quiet iwd 2>/dev/null; then
    pass "iwd enabled/active (Wi-Fi backend)"
  else
    note "iwd not enabled (Wi-Fi may use wpa_supplicant)"
  fi
  if [[ -f /etc/NetworkManager/conf.d/wifi_backend.conf ]] \
    && grep -q 'wifi.backend=iwd' /etc/NetworkManager/conf.d/wifi_backend.conf; then
    pass "NM wifi.backend=iwd"
  else
    note "NM iwd wifi_backend.conf missing"
  fi
  if systemctl is-active --quiet bluetooth 2>/dev/null; then
    pass "bluetooth.service active"
  elif systemctl is-enabled --quiet bluetooth 2>/dev/null; then
    note "bluetooth enabled (no adapter or not started yet)"
  else
    bad "bluetooth.service not enabled"
  fi
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    if pgrep -u "$UID" -x pipewire >/dev/null 2>&1; then
      pass "pipewire running for user"
    else
      bad "pipewire not running in graphical session"
    fi
    if pgrep -u "$UID" -x wireplumber >/dev/null 2>&1 \
      || systemctl --user is-active --quiet wireplumber 2>/dev/null; then
      pass "wireplumber running for user"
    else
      note "wireplumber not observed (may still be starting)"
    fi
  else
    note "skip user PipeWire check (not in graphical session)"
  fi
  if [[ -L /etc/systemd/user/sockets.target.wants/pipewire.socket ]] \
    || [[ -L /etc/systemd/user/default.target.wants/wireplumber.service ]]; then
    pass "PipeWire user units enabled globally"
  else
    note "PipeWire global user wants missing (session-ready may still start it)"
  fi
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx bluetooth; then
    pass "user in bluetooth group"
  else
    note "current user not in bluetooth group (re-login after ensure)"
  fi
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
    pass "user in audio group"
  else
    note "current user not in audio group"
  fi
  if [[ -x /usr/local/bin/etheris-session-ready ]] \
    && [[ -x /usr/local/bin/etheris-bt-status ]]; then
    pass "session-ready + bt-status helpers"
  else
    bad "session-ready / bt-status missing"
  fi
  if command -v nm-applet >/dev/null 2>&1 && command -v blueman-manager >/dev/null 2>&1 \
    && command -v pavucontrol >/dev/null 2>&1; then
    pass "nm-applet + blueman + pavucontrol present"
  else
    note "one of nm-applet / blueman / pavucontrol missing from PATH"
  fi
  if command -v rfkill >/dev/null 2>&1; then
    if rfkill list 2>/dev/null | grep -qi 'Soft blocked: yes'; then
      note "rfkill soft-block present (session-ready unblocks wifi/bt)"
    else
      pass "no rfkill soft-blocks"
    fi
  fi
}

emit_json() {
  printf '{"ok":%d,"fail":%d,"warn":%d,"passed":%s}\n' \
    "$ok" "$fail" "$warn" "$([[ $fail -eq 0 ]] && echo true || echo false)"
}

main() {
  local mode="${1:-}"
  case "$mode" in
    help|-h|--help) usage; exit 0 ;;
    --json) ;;
    "") ;;
    *) usage; exit 2 ;;
  esac

  echo "Etheris doctor"
  echo "  host: $(hostname 2>/dev/null || echo unknown)"
  echo "  when: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

  run_auth
  run_security
  run_units
  run_firewall
  run_greeter
  run_session_hint
  run_tooling
  run_connectivity

  echo
  echo "Summary: $ok OK, $fail FAIL, $warn WARN"
  if [[ "$mode" == "--json" ]]; then
    emit_json
  fi
  if ((fail)); then
    echo "doctor: FAILED"
    exit 1
  fi
  echo "doctor: PASSED"
  exit 0
}

main "${1:-}"
