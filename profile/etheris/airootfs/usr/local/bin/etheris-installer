#!/usr/bin/env bash
# Etheris OS installer (UEFI + systemd-boot + ext4/btrfs) — safety-first
# Logs: /var/log/etheris-install.log  and  ./etheris-install-*.log
#
# Non-interactive VM/CI mode (still requires explicit YES):
#   sudo etheris-installer --auto \
#     --disk /dev/vda --confirm YES \
#     --user NAME --password PASS \
#     [--hostname H] [--locale L] [--timezone TZ] [--keymap KM] [--fs ext4|btrfs] [--no-reboot]
set -euo pipefail

VERSION="$(cat /usr/local/share/etheris/VERSION 2>/dev/null || cat /etc/etheris-version 2>/dev/null || echo 0.1.0-alpha)"
LOG="/var/log/etheris-install.log"
ALT_LOG="${HOME}/etheris-install-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
exec > >(tee -a "$LOG" "$ALT_LOG") 2>&1

die() { echo "ERROR: $*" >&2; echo "Installation FAILED — see $LOG"; exit 1; }
info() { echo "==> $*"; }
confirm() {
  local prompt="$1" ans
  echo
  echo "$prompt"
  if [[ "${AUTO:-0}" -eq 1 ]]; then
    [[ "${CONFIRM:-}" == "YES" ]] || die "Auto mode requires --confirm YES (got '${CONFIRM:-}')"
    echo "AUTO: confirmation=YES"
    return 0
  fi
  read -r -p "Type YES to continue: " ans
  [[ "$ans" == "YES" ]] || die "Aborted by user (confirmation not YES)"
}

AUTO=0
NO_REBOOT=0
TARGET=""
CONFIRM=""
FS=ext4
HOSTNAME=etheris
USERNAME=""
PASS1=""
LOCALE=en_US.UTF-8
TZ=UTC
KEYMAP=us
LUKS="${ETHERIS_INSTALL_LUKS:-0}"
LUKS_PASS="${ETHERIS_LUKS_PASSPHRASE:-}"
CRYPTNAME=cryptroot

usage() {
  cat <<'EOF'
Usage:
  etheris-installer                 Interactive install
  etheris-installer --auto …        Non-interactive (still needs --confirm YES)

Auto flags:
  --disk /dev/vdX     Target disk (required)
  --confirm YES       Exact destructive confirmation (required)
  --user NAME         Primary user (required)
  --password PASS     Password (required; not logged beyond chpasswd stdin)
  --hostname NAME     Default: etheris
  --locale LOCALE     Default: en_US.UTF-8
  --timezone TZ       Default: UTC
  --keymap KEYMAP     Console/XKB layout (default: us) — persists after reboot
  --fs ext4|btrfs     Default: ext4
  --luks              Encrypt root with LUKS2 (opt-in)
  --luks-passphrase P LUKS passphrase (default: same as user password)
  --no-reboot         Do not reboot at end

Env: ETHERIS_INSTALL_LUKS=1  ETHERIS_LUKS_PASSPHRASE=…  ETHERIS_INSTALL_GAMING=1

Persistence gates (docs/INSTALL-PERSISTENCE.md): password, keymap, timezone,
locale, NetworkManager autoconnect, display (etheris-display save), bootloader.

Failure modes / recovery: docs/INSTALLER-FAILURE-MODES.md
LUKS recovery: docs/LUKS-PLAN.md
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto) AUTO=1; shift ;;
    --no-reboot) NO_REBOOT=1; shift ;;
    --disk) TARGET="${2:-}"; shift 2 ;;
    --confirm) CONFIRM="${2:-}"; shift 2 ;;
    --user) USERNAME="${2:-}"; shift 2 ;;
    --password) PASS1="${2:-}"; shift 2 ;;
    --hostname) HOSTNAME="${2:-}"; shift 2 ;;
    --locale) LOCALE="${2:-}"; shift 2 ;;
    --timezone) TZ="${2:-}"; shift 2 ;;
    --keymap) KEYMAP="${2:-}"; shift 2 ;;
    --fs) FS="${2:-}"; shift 2 ;;
    --luks) LUKS=1; shift ;;
    --luks-passphrase) LUKS_PASS="${2:-}"; LUKS=1; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown argument: $1" ;;
  esac
done

[[ "$(id -u)" -eq 0 ]] || die "Run as root: sudo etheris-installer"

if [[ "$AUTO" -eq 0 ]]; then
  clear
  cat <<EOF
╔══════════════════════════════════════════╗
║         Etheris OS Installer            ║
║              ${VERSION}                  ║
╚══════════════════════════════════════════╝

Safety rules:
  • Nothing is formatted without typing YES
  • USB install media will be excluded when possible
  • UEFI + systemd-boot (ext4 or Btrfs)
  • Classic mutable install (immutable A/B is planned — see docs)
  • Btrfs uses future-friendly subvolumes (@, @home, @var_log)
  • Full log: $LOG

EOF
  read -r -p "Press Enter to begin (Ctrl+C to quit)… "
fi

# --- hardware ---
info "Hardware detection"
efi=0
[[ -d /sys/firmware/efi ]] && efi=1
echo "  UEFI firmware: $([[ $efi -eq 1 ]] && echo yes || echo NO)"
[[ $efi -eq 1 ]] || die "This installer version requires UEFI. Legacy BIOS/GRUB comes later."
echo "  CPU: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | xargs)"
echo "  RAM: $(awk '/MemTotal/{printf "%.1f GiB", $2/1024/1024}' /proc/meminfo)"

# --- disks ---
info "Disk detection (excluding obvious USB installer / loop / ram)"
# Parse with NUL-safe columns — empty MODEL/TRAN must not shift fields (breaks virtio).
# NAME,TYPE only — empty MODEL/TRAN must not shift fields (breaks virtio VMs).
mapfile -t DISKS < <(
  lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}' | while read -r name; do
      [[ -n "$name" ]] || continue
      path="/dev/$name"
      [[ -b "$path" ]] || continue
      size="$(lsblk -dn -o SIZE "$path" 2>/dev/null | tr -d ' ')"
      model="$(lsblk -dn -o MODEL "$path" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      tran="$(lsblk -dn -o TRAN "$path" 2>/dev/null | tr -d ' ')"
      rmflag="$(lsblk -dn -o RM "$path" 2>/dev/null | tr -d ' ')"
      echo "${path}|${size}|${model}|${tran}|rm=${rmflag}"
    done
)

LIVE_SRC="$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || findmnt -n -o SOURCE /run/archiso/copytoram 2>/dev/null || true)"
LIVE_DISK=""
if [[ -n "$LIVE_SRC" ]]; then
  LIVE_DISK="$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null || true)"
  [[ -n "$LIVE_DISK" ]] && LIVE_DISK="/dev/$LIVE_DISK"
fi

echo
echo "Available target disks:"
i=1
declare -a CHOICES=()
for entry in "${DISKS[@]}"; do
  path="${entry%%|*}"
  rest="${entry#*|}"
  if [[ -n "$LIVE_DISK" && "$path" == "$LIVE_DISK" ]]; then
    echo "  [skipped installer media] $path ($rest)"
    continue
  fi
  echo "  $i) $path ($rest)"
  CHOICES+=("$path")
  i=$((i+1))
done
if [[ "$AUTO" -eq 1 ]]; then
  [[ -n "$TARGET" ]] || die "--disk required in --auto mode"
  [[ -b "$TARGET" ]] || die "Not a block device: $TARGET"
  [[ "$CONFIRM" == "YES" ]] || die "--confirm YES required in --auto mode"
  [[ -n "$USERNAME" ]] || die "--user required"
  [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username"
  [[ -n "$PASS1" ]] || die "--password required"
  case "$FS" in ext4|btrfs) ;; *) die "Unsupported filesystem: $FS" ;; esac
  # Refuse installing onto live ISO medium
  if [[ -n "$LIVE_DISK" && "$TARGET" == "$LIVE_DISK" ]]; then
    die "Refusing to install onto live installer medium ($TARGET)"
  fi
  # Warn if detection list empty (virtio parse bugs used to trigger this)
  if (( ${#CHOICES[@]} == 0 )); then
    echo "WARNING: disk auto-detection returned no entries; continuing with --disk $TARGET"
  fi
else
  (( ${#CHOICES[@]} > 0 )) || die "No suitable disks found"
  read -r -p "Select disk number: " num
  [[ "$num" =~ ^[0-9]+$ ]] || die "Invalid selection"
  (( num >= 1 && num <= ${#CHOICES[@]} )) || die "Out of range"
  TARGET="${CHOICES[$((num-1))]}"

  info "Selected target disk: $TARGET"
  lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS "$TARGET"
  echo
  echo "WARNING: Continuing will ERASE ALL DATA on $TARGET"
  confirm "Destroy all partitions on $TARGET and install Etheris OS?"

  echo "Filesystem:"
  echo "  ext4  — simple mutable root (default)"
  echo "  btrfs — mutable root with @/@home/@var_log (preferred later for A/B immutability)"
  read -r -p "Filesystem [ext4/btrfs] (default ext4): " fs_in || true
  case "${fs_in:-ext4}" in
    ext4|btrfs) FS="$fs_in" ;;
    *) die "Unsupported filesystem: $fs_in" ;;
  esac

  read -r -p "Hostname [etheris]: " HOSTNAME
  HOSTNAME="${HOSTNAME:-etheris}"
  read -r -p "Username: " USERNAME
  [[ -n "$USERNAME" ]] || die "Username required"
  [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username"
  read -r -s -p "Password: " PASS1; echo
  read -r -s -p "Password (again): " PASS2; echo
  [[ "$PASS1" == "$PASS2" ]] || die "Passwords do not match"
  [[ -n "$PASS1" ]] || die "Password empty"

  read -r -p "Locale [en_US.UTF-8]: " LOCALE
  LOCALE="${LOCALE:-en_US.UTF-8}"
  read -r -p "Timezone [UTC]: " TZ
  TZ="${TZ:-UTC}"
  read -r -p "Keyboard layout [us]: " KEYMAP
  KEYMAP="${KEYMAP:-us}"

  echo
  echo "Disk encryption (LUKS2) is optional. You must remember the passphrase."
  read -r -p "Encrypt root partition with LUKS? [y/N]: " luks_in || true
  case "${luks_in:-n}" in
    y|Y|yes|YES) LUKS=1 ;;
    *) LUKS=0 ;;
  esac
  if [[ "$LUKS" == "1" ]]; then
    read -r -s -p "LUKS passphrase (empty = use login password): " LUKS_PASS; echo
    read -r -s -p "LUKS passphrase (again): " LUKS_PASS2; echo
    if [[ -z "$LUKS_PASS" ]]; then
      LUKS_PASS="$PASS1"
    else
      [[ "$LUKS_PASS" == "$LUKS_PASS2" ]] || die "LUKS passphrases do not match"
    fi
  fi
fi

# Auto / env LUKS passphrase default
if [[ "$LUKS" == "1" && -z "$LUKS_PASS" ]]; then
  LUKS_PASS="$PASS1"
fi
[[ "$LUKS" == "1" && -n "$LUKS_PASS" ]] || [[ "$LUKS" != "1" ]] || die "LUKS enabled but passphrase empty"

info "Selected target disk: $TARGET"
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS "$TARGET" || true

echo
info "Installation summary"
echo "  Disk:      $TARGET"
echo "  Filesystem:$FS"
echo "  LUKS:      $([[ "$LUKS" == "1" ]] && echo yes || echo no)"
echo "  Hostname:  $HOSTNAME"
echo "  User:      $USERNAME"
echo "  Locale:    $LOCALE"
echo "  Timezone:  $TZ"
echo "  Keymap:    $KEYMAP"
echo "  Boot:      UEFI systemd-boot"
echo "  Desktop:   Etheris (Sway)"
echo "  Mode:      $([[ $AUTO -eq 1 ]] && echo auto || echo interactive)"
confirm "Proceed with installation onto $TARGET?"
MNT=/mnt
umount -R "$MNT" 2>/dev/null || true

info "Partitioning $TARGET"
sgdisk --zap-all "$TARGET"
sgdisk -n1:0:+1G -t1:EF00 -c1:"EFI System" "$TARGET"
sgdisk -n2:0:0   -t2:8300 -c2:"Etheris Root" "$TARGET"
sleep 1
partprobe "$TARGET" || true
# Resolve partition names (NVMe uses p1)
if [[ -b "${TARGET}p1" ]]; then
  P1="${TARGET}p1"; P2="${TARGET}p2"
elif [[ -b "${TARGET}1" ]]; then
  P1="${TARGET}1"; P2="${TARGET}2"
else
  die "Could not find partitions on $TARGET"
fi

info "Formatting"
mkfs.fat -F32 -n EFI "$P1"
ROOT_DEV="$P2"
LUKS_UUID=""
if [[ "$LUKS" == "1" ]]; then
  command -v cryptsetup >/dev/null || die "cryptsetup missing on live ISO"
  info "Creating LUKS2 container on $P2 (passphrase not logged)"
  printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --type luks2 --batch-mode --key-file=- "$P2"
  printf '%s' "$LUKS_PASS" | cryptsetup open --key-file=- "$P2" "$CRYPTNAME"
  ROOT_DEV="/dev/mapper/${CRYPTNAME}"
  LUKS_UUID="$(cryptsetup luksUUID "$P2")"
  [[ -n "$LUKS_UUID" ]] || die "Could not read LUKS UUID"
fi
case "$FS" in
  ext4) mkfs.ext4 -F -L Etheris "$ROOT_DEV" ;;
  btrfs) mkfs.btrfs -f -L Etheris "$ROOT_DEV" ;;
esac

info "Mounting"
BTRFS_OPTS="defaults,noatime,compress=zstd:3"
if [[ "$FS" == btrfs ]]; then
  # Future-friendly layout: separate home/log from OS root (still mutable today).
  # Later A/B can replace @ with @a/@b without moving @home.
  mount "$ROOT_DEV" "$MNT"
  btrfs subvolume create "$MNT/@"
  btrfs subvolume create "$MNT/@home"
  btrfs subvolume create "$MNT/@var_log"
  umount "$MNT"
  mount -o "${BTRFS_OPTS},subvol=@" "$ROOT_DEV" "$MNT"
  mkdir -p "$MNT/home" "$MNT/var/log" "$MNT/boot"
  mount -o "${BTRFS_OPTS},subvol=@home" "$ROOT_DEV" "$MNT/home"
  mount -o "${BTRFS_OPTS},subvol=@var_log" "$ROOT_DEV" "$MNT/var/log"
else
  mount "$ROOT_DEV" "$MNT"
  mkdir -p "$MNT/boot"
fi
mount "$P1" "$MNT/boot"

info "Installing base system (lean desktop; gaming opt-in)"
# Ensure multilib when gaming is requested (Steam / lib32)
enable_multilib() {
  if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
    if grep -q '^#\[multilib\]' /etc/pacman.conf; then
      sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/{s/^#//}' /etc/pacman.conf
    else
      printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
    fi
  fi
}
# Core desktop install set. Gaming is opt-in: ETHERIS_INSTALL_GAMING=1
# (live ISO may still ship the stack for try-before-install).
PKGS=(base linux linux-firmware networkmanager pipewire pipewire-pulse wireplumber
  sway swaybg swayidle swaylock waybar foot wofi rofi mako pcmanfm
  gvfs gvfs-mtp gvfs-smb gvfs-nfs
  warpinator blueman bluez-obex avahi
  xdg-desktop-portal-wlr greetd greetd-regreet greetd-tuigreet
  sudo polkit polkit-gnome nano micro git nftables
  amd-ucode intel-ucode efibootmgr dosfstools e2fsprogs
  iwd wireless-regdb
  mesa mesa-utils vulkan-icd-loader vulkan-intel vulkan-radeon
  intel-media-driver libva-utils
  bluez bluez-utils
  lm_sensors cpupower)
# Gaming stack: OFF by default (lean installs). Opt in: ETHERIS_INSTALL_GAMING=1
GAMING="${ETHERIS_INSTALL_GAMING:-0}"
if [[ "$GAMING" == "1" ]]; then
  enable_multilib
  info "Including Steam/gaming packages (ETHERIS_INSTALL_GAMING=1)"
  if [[ -f /usr/local/share/etheris/gaming-packages.list ]]; then
    mapfile -t _gpkgs < <(grep -vE '^\s*(#|$)' /usr/local/share/etheris/gaming-packages.list)
    PKGS+=("${_gpkgs[@]}")
  else
    PKGS+=(lib32-mesa lib32-vulkan-icd-loader lib32-vulkan-intel lib32-vulkan-radeon
      lib32-pipewire lib32-libpipewire lib32-alsa-plugins lib32-libpulse
      lib32-gnutls lib32-sqlite lib32-libcups lib32-vkd3d
      lib32-freetype2 lib32-curl lib32-dbus lib32-fontconfig
      openal vkd3d
      steam steam-devices gamemode lib32-gamemode mangohud lib32-mangohud
      gamescope wine wine-mono wine-gecko winetricks zenity cabextract
      protontricks umu-launcher
      gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav
      vulkan-tools libva-intel-driver)
  fi
else
  info "Lean install (no Steam/gaming). Opt in later or reinstall with ETHERIS_INSTALL_GAMING=1."
fi
[[ "$FS" == btrfs ]] && PKGS+=(btrfs-progs)
[[ "$LUKS" == "1" ]] && PKGS+=(cryptsetup)
pacstrap -K "$MNT" "${PKGS[@]}"

info "fstab"
genfstab -U "$MNT" >> "$MNT/etc/fstab"
if [[ "$LUKS" == "1" ]]; then
  # crypttab for initramfs encrypt hook / late unlock helpers
  printf '%s UUID=%s none luks,discard\n' "$CRYPTNAME" "$LUKS_UUID" >"$MNT/etc/crypttab"
fi

info "Configuring system"
arch-chroot "$MNT" bash -s -- "$TZ" "$LOCALE" "$HOSTNAME" "$USERNAME" "$KEYMAP" "$FS" <<'CHROOT'
set -euo pipefail
TZ="$1"; LOCALE="$2"; HOSTNAME="$3"; USERNAME="$4"; KEYMAP="$5"; FS="$6"
ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime
hwclock --systohc
sed -i "s/^#${LOCALE}/${LOCALE}/" /etc/locale.gen || echo "${LOCALE} UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=${LOCALE}" > /etc/locale.conf
# Console keymap (persists; greeter patched after greeter files are copied)
case "$KEYMAP" in
  se|sv) CKEY=sv-latin1 ;;
  uk|gb) CKEY=uk ;;
  de) CKEY=de-latin1 ;;
  fr) CKEY=fr-latin9 ;;
  fi) CKEY=fi ;;
  no) CKEY=no-latin1 ;;
  dk) CKEY=dk-latin1 ;;
  *) CKEY="$KEYMAP" ;;
esac
printf 'KEYMAP=%s\nFONT=lat9w-16\n' "$CKEY" > /etc/vconsole.conf
echo "${HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 ${HOSTNAME}.localdomain ${HOSTNAME}
EOF
id "$USERNAME" >/dev/null 2>&1 || useradd -m -G wheel,audio,video,storage,input,render,network,power,lp,optical,rfkill,users -s /bin/bash "$USERNAME"
usermod -aG wheel,audio,video,storage,input,render,network,power,lp,optical,rfkill,users "$USERNAME"
# GameMode renice privileges (group from gamemode package; create if gaming stack present)
if command -v gamemoderun >/dev/null 2>&1 || pacman -Qq gamemode &>/dev/null; then
  groupadd -f gamemode 2>/dev/null || true
  usermod -aG gamemode "$USERNAME"
elif getent group gamemode >/dev/null 2>&1; then
  usermod -aG gamemode "$USERNAME"
fi
# Polkit: wheel GUI admin (copied from share after overlay; placeholder ok)
install -d -m 755 /etc/polkit-1/rules.d
if [[ -f /usr/local/share/etheris/polkit/49-etheris-wheel.rules ]]; then
  install -m 644 /usr/local/share/etheris/polkit/49-etheris-wheel.rules \
    /etc/polkit-1/rules.d/49-etheris-wheel.rules
fi
# Standard Places folders for the file manager (Downloads, Pictures, …)
install -d -o "$USERNAME" -g "$USERNAME" \
  "/home/${USERNAME}/Desktop" \
  "/home/${USERNAME}/Documents" \
  "/home/${USERNAME}/Downloads" \
  "/home/${USERNAME}/Music" \
  "/home/${USERNAME}/Pictures" \
  "/home/${USERNAME}/Pictures/Wallpapers" \
  "/home/${USERNAME}/Pictures/Screenshots" \
  "/home/${USERNAME}/Videos" \
  "/home/${USERNAME}/Templates" \
  "/home/${USERNAME}/Public" \
  "/home/${USERNAME}/Downloads/Etheris Transfers" \
  "/home/${USERNAME}/Downloads/Bluetooth"
if [[ -f /etc/skel/.config/user-dirs.dirs ]]; then
  install -D -o "$USERNAME" -g "$USERNAME" -m 644 \
    /etc/skel/.config/user-dirs.dirs "/home/${USERNAME}/.config/user-dirs.dirs"
fi
mkdir -p "/home/${USERNAME}/.config/gtk-3.0"
cat >"/home/${USERNAME}/.config/gtk-3.0/bookmarks" <<EOF
file:///home/${USERNAME}/Desktop Desktop
file:///home/${USERNAME}/Documents Documents
file:///home/${USERNAME}/Downloads Downloads
file:///home/${USERNAME}/Music Music
file:///home/${USERNAME}/Pictures Pictures
file:///home/${USERNAME}/Pictures/Wallpapers Wallpapers
file:///home/${USERNAME}/Pictures/Screenshots Screenshots
file:///home/${USERNAME}/Videos Videos
file:///home/${USERNAME}/Public Public
file:///home/${USERNAME}/Downloads/Etheris%20Transfers Etheris Transfers
EOF
# Desktop keyboard persists in user Sway config.d
install -d -o "$USERNAME" -g "$USERNAME" "/home/${USERNAME}/.config/sway/config.d"
cat >"/home/${USERNAME}/.config/sway/config.d/10-keyboard.conf" <<EOF
# Written by etheris-installer — keyboard persists after reboot
input type:keyboard {
    xkb_layout ${KEYMAP}
}
EOF
chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}/.config"
# Password sudo on installed systems (not live NOPASSWD)
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel
# Never leave live-ISO passwordless sudo on the installed root
rm -f /etc/sudoers.d/etheris
# Enable multilib on installed system
if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
  if grep -q '^#\[multilib\]' /etc/pacman.conf; then
    sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/{s/^#//}' /etc/pacman.conf
  else
    printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
  fi
fi
# Network + time sync (reconnect + correct clock after reboot)
systemctl enable NetworkManager iwd greetd nftables bluetooth avahi-daemon systemd-timesyncd
systemctl mask sshd.service 2>/dev/null || true
# Never enable live password-resetter on installed systems
systemctl disable etheris-auth-setup.service 2>/dev/null || true
systemctl mask etheris-auth-setup.service 2>/dev/null || true
rm -f /etc/systemd/system/multi-user.target.wants/etheris-auth-setup.service \
  /etc/systemd/system/graphical.target.wants/etheris-auth-setup.service 2>/dev/null || true
bootctl install
mkdir -p /boot/loader/entries
cat > /boot/loader/loader.conf <<EOF
default etheris.conf
timeout 3
console-mode keep
EOF
ROOT_UUID=$(findmnt -no UUID /)
ROOT_OPTS="root=UUID=${ROOT_UUID} rw quiet"
# Btrfs root is subvolume @ — required for reboot/boot after updates
if [[ "$FS" == btrfs ]] || findmnt -no FSTYPE / 2>/dev/null | grep -qx btrfs; then
  ROOT_OPTS="root=UUID=${ROOT_UUID} rootflags=subvol=@ rw quiet"
fi
# Microcode early initrd (both packages installed; unused image is harmless if absent)
# LUKS cryptdevice= is patched in by the installer after chroot when --luks is set.
{
  echo "title   Etheris OS"
  echo "linux   /vmlinuz-linux"
  [[ -f /boot/amd-ucode.img ]] && echo "initrd  /amd-ucode.img"
  [[ -f /boot/intel-ucode.img ]] && echo "initrd  /intel-ucode.img"
  echo "initrd  /initramfs-linux.img"
  echo "options ${ROOT_OPTS}"
} > /boot/loader/entries/etheris.conf
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml <<EOF
[terminal]
vt = 1
[default_session]
command = "sway --config /etc/greetd/sway-config"
user = "greeter"
EOF
CHROOT
# Passwords via chpasswd stdin only (not written into heredoc / logs)
printf 'root:%s\n%s:%s\n' "$PASS1" "$USERNAME" "$PASS1" | arch-chroot "$MNT" chpasswd

# LUKS: encrypt hook + cryptdevice= on kernel cmdline + rebuild initramfs
if [[ "$LUKS" == "1" ]]; then
  info "Configuring LUKS initramfs (encrypt hook)"
  arch-chroot "$MNT" bash -s -- "$LUKS_UUID" "$CRYPTNAME" "$FS" <<'LUKSCHROOT'
set -euo pipefail
LUKS_UUID="$1"; CRYPTNAME="$2"; FS="$3"
# Ensure encrypt hook runs before filesystems (drop-in is most reliable)
mkdir -p /etc/mkinitcpio.conf.d
if ! grep -qE '^HOOKS=.*\bencrypt\b' /etc/mkinitcpio.conf 2>/dev/null; then
  cat >/etc/mkinitcpio.conf.d/etheris-luks.conf <<'HOOK'
# Etheris LUKS — encrypt before filesystems
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block encrypt filesystems fsck)
HOOK
fi
ROOT_UUID=$(findmnt -no UUID /)
ROOT_OPTS="cryptdevice=UUID=${LUKS_UUID}:${CRYPTNAME} root=UUID=${ROOT_UUID} rw quiet"
if [[ "$FS" == btrfs ]] || findmnt -no FSTYPE / 2>/dev/null | grep -qx btrfs; then
  ROOT_OPTS="cryptdevice=UUID=${LUKS_UUID}:${CRYPTNAME} root=UUID=${ROOT_UUID} rootflags=subvol=@ rw quiet"
fi
{
  echo "title   Etheris OS"
  echo "linux   /vmlinuz-linux"
  [[ -f /boot/amd-ucode.img ]] && echo "initrd  /amd-ucode.img"
  [[ -f /boot/intel-ucode.img ]] && echo "initrd  /intel-ucode.img"
  echo "initrd  /initramfs-linux.img"
  echo "options ${ROOT_OPTS}"
} > /boot/loader/entries/etheris.conf
mkinitcpio -P
LUKSCHROOT
fi
# Apply Etheris firewall/privacy defaults when present on live medium
[[ -f /etc/nftables.conf ]] && cp -a /etc/nftables.conf "$MNT/etc/nftables.conf"
# Graphical greeter (ReGreet) assets from live ISO
if [[ -d /etc/greetd ]]; then
  mkdir -p "$MNT/etc/greetd"
  for f in sway-config regreet.toml regreet.css config.toml; do
    [[ -f "/etc/greetd/$f" ]] && cp -a "/etc/greetd/$f" "$MNT/etc/greetd/"
  done
fi
# Persist install keymap on greeter seat
if [[ -x /usr/local/bin/etheris-keymap-apply ]]; then
  cp -a /usr/local/bin/etheris-keymap-apply "$MNT/usr/local/bin/"
  arch-chroot "$MNT" etheris-keymap-apply "$KEYMAP" || true
elif [[ -f "$MNT/etc/greetd/sway-config" ]]; then
  sed -i -E "s/^(\s*xkb_layout\s+).*/\1${KEYMAP}/" "$MNT/etc/greetd/sway-config" || true
fi
# NetworkManager Wi-Fi backend (iwd) so reconnect works like live
mkdir -p "$MNT/etc/NetworkManager/conf.d"
if [[ -f /etc/NetworkManager/conf.d/wifi_backend.conf ]]; then
  cp -a /etc/NetworkManager/conf.d/wifi_backend.conf "$MNT/etc/NetworkManager/conf.d/"
else
  printf '[device]\nwifi.backend=iwd\n' >"$MNT/etc/NetworkManager/conf.d/wifi_backend.conf"
fi
# Polkit wheel rule (path the chroot expects)
mkdir -p "$MNT/usr/local/share/etheris/polkit" "$MNT/etc/polkit-1/rules.d"
if [[ -f /usr/local/share/etheris/polkit/49-etheris-wheel.rules ]]; then
  cp -a /usr/local/share/etheris/polkit/49-etheris-wheel.rules "$MNT/usr/local/share/etheris/polkit/"
elif [[ -f /etc/polkit-1/rules.d/49-etheris-wheel.rules ]]; then
  cp -a /etc/polkit-1/rules.d/49-etheris-wheel.rules "$MNT/usr/local/share/etheris/polkit/49-etheris-wheel.rules"
fi
[[ -f "$MNT/usr/local/share/etheris/polkit/49-etheris-wheel.rules" ]] && \
  install -m 644 "$MNT/usr/local/share/etheris/polkit/49-etheris-wheel.rules" \
    "$MNT/etc/polkit-1/rules.d/49-etheris-wheel.rules"
# systemd-boot refresh after kernel/systemd updates
mkdir -p "$MNT/etc/pacman.d/hooks"
[[ -f /etc/pacman.d/hooks/etheris-bootctl.hook ]] && \
  cp -a /etc/pacman.d/hooks/etheris-bootctl.hook "$MNT/etc/pacman.d/hooks/"
[[ -x /usr/local/bin/etheris-greeter ]] && cp -a /usr/local/bin/etheris-greeter "$MNT/usr/local/bin/"
[[ -x /usr/local/bin/etheris-greeter-tui ]] && cp -a /usr/local/bin/etheris-greeter-tui "$MNT/usr/local/bin/"
[[ -x /usr/local/bin/etheris-display ]] && cp -a /usr/local/bin/etheris-display "$MNT/usr/local/bin/"
[[ -f /etc/etheris/privacy.conf ]] && mkdir -p "$MNT/etc/etheris" && cp -a /etc/etheris/privacy.conf "$MNT/etc/etheris/"
[[ -f /etc/etheris/cpu.conf ]] && cp -a /etc/etheris/cpu.conf "$MNT/etc/etheris/"
mkdir -p "$MNT/etc/etheris" "$MNT/usr/local/share/etheris/docs"
# Deployment mode: Btrfs installs get immutable-prep; ext4 stays mutable-classic.
if [[ "$FS" == btrfs ]]; then
  cat >"$MNT/etc/etheris/system-mode.conf" <<'MODE'
# Etheris OS deployment mode (written by installer)
# immutable-prep = /usr can be remounted read-only; A/B updates NOT active
# mutable-classic = normal writable Arch root

MODE=immutable-prep
IMMUTABLE_PLANNED=yes
DOCUMENTATION=/usr/local/share/etheris/docs/IMMUTABLE.md
MODE
else
  cat >"$MNT/etc/etheris/system-mode.conf" <<'MODE'
# Etheris OS deployment mode (written by installer)

MODE=mutable-classic
IMMUTABLE_PLANNED=yes
DOCUMENTATION=/usr/local/share/etheris/docs/IMMUTABLE.md
MODE
fi
for d in IMMUTABLE.md HARDWARE.md GAMING.md DRIVER-RECOVERY.md PERFORMANCE-MANAGER.md INSTALL-PERSISTENCE.md POLKIT.md SECURITY.md OOBE.md; do
  [[ -f "/usr/local/share/etheris/docs/$d" ]] && cp -a "/usr/local/share/etheris/docs/$d" "$MNT/usr/local/share/etheris/docs/"
done

[[ -f /etc/sysctl.d/99-etheris-security.conf ]] && cp -a /etc/sysctl.d/99-etheris-security.conf "$MNT/etc/sysctl.d/"
# Proton map count + NVIDIA Wayland modeset (safe even when gaming stack is lean)
[[ -f /etc/sysctl.d/99-etheris-gaming.conf ]] && cp -a /etc/sysctl.d/99-etheris-gaming.conf "$MNT/etc/sysctl.d/"
mkdir -p "$MNT/etc/modprobe.d"
[[ -f /etc/modprobe.d/etheris-nvidia.conf ]] && cp -a /etc/modprobe.d/etheris-nvidia.conf "$MNT/etc/modprobe.d/"
[[ -d /etc/pacman.d/hooks ]] && mkdir -p "$MNT/etc/pacman.d/hooks"
[[ -f /etc/pacman.d/hooks/etheris-nvidia-pascal-guard.hook ]] && \
  cp -a /etc/pacman.d/hooks/etheris-nvidia-pascal-guard.hook "$MNT/etc/pacman.d/hooks/" 2>/dev/null || true
[[ -f /etc/pacman.d/hooks/etheris-steam-desktop.hook ]] && \
  cp -a /etc/pacman.d/hooks/etheris-steam-desktop.hook "$MNT/etc/pacman.d/hooks/" 2>/dev/null || true
[[ -f /etc/pacman.d/hooks/etheris-bootctl.hook ]] && \
  cp -a /etc/pacman.d/hooks/etheris-bootctl.hook "$MNT/etc/pacman.d/hooks/" 2>/dev/null || true
[[ -f /etc/systemd/system/etheris-cpu-setup.service ]] && \
  cp -a /etc/systemd/system/etheris-cpu-setup.service "$MNT/etc/systemd/system/" 2>/dev/null || true
PASS1=''
PASS2=''

# Copy Etheris branding / configs / lag mirrors into target
info "Installing Etheris overlay"
mkdir -p "$MNT/etc/etheris" "$MNT/var/lib/etheris"
cp -a /etc/etheris/channels.conf "$MNT/etc/etheris/" 2>/dev/null || true
cp -a /var/lib/etheris/. "$MNT/var/lib/etheris/" 2>/dev/null || true
cp -a /usr/local/bin/etheris-update "$MNT/usr/local/bin/" 2>/dev/null || true
mkdir -p "$MNT/usr/local" "$MNT/etc/pacman.d"
cp -a /usr/local/bin/etheris* "$MNT/usr/local/bin/" 2>/dev/null || true
cp -a /usr/local/share/etheris "$MNT/usr/local/share/" 2>/dev/null || true
# Steam must launch via etheris-steam (space/DNS/XWayland guards). Pacstrap
# installs stock steam.desktop — ship XDG entry under /usr/local + template,
# and rewrite /usr/share so non-XDG tools also hit the wrapper.
mkdir -p "$MNT/usr/local/share/applications" "$MNT/usr/local/share/etheris/desktop" \
  "$MNT/usr/share/applications"
_steam_src=""
if [[ -f /usr/local/share/etheris/desktop/steam.desktop ]]; then
  _steam_src=/usr/local/share/etheris/desktop/steam.desktop
elif [[ -f /usr/local/share/applications/steam.desktop ]]; then
  _steam_src=/usr/local/share/applications/steam.desktop
fi
if [[ -n "$_steam_src" ]] && grep -q '^Exec=etheris-steam' "$_steam_src"; then
  cp -a "$_steam_src" "$MNT/usr/local/share/applications/steam.desktop"
  cp -a "$_steam_src" "$MNT/usr/local/share/etheris/desktop/steam.desktop"
  cp -a "$_steam_src" "$MNT/usr/share/applications/steam.desktop"
fi
unset _steam_src
# Wayland session: Etheris (Sway) must ship; hide stock sway.desktop from greeters
mkdir -p "$MNT/usr/share/wayland-sessions"
if [[ -f /usr/share/wayland-sessions/etheris.desktop ]]; then
  cp -a /usr/share/wayland-sessions/etheris.desktop "$MNT/usr/share/wayland-sessions/"
fi
if [[ -x "$MNT/usr/local/bin/etheris-hide-stock-sway" ]]; then
  arch-chroot "$MNT" /usr/local/bin/etheris-hide-stock-sway || true
elif [[ -f "$MNT/usr/share/wayland-sessions/sway.desktop" ]]; then
  # Fallback if hide helper missing from overlay
  grep -v -E '^(Hidden|NoDisplay)=' "$MNT/usr/share/wayland-sessions/sway.desktop" \
    >"$MNT/usr/share/wayland-sessions/sway.desktop.tmp" || true
  printf 'NoDisplay=true\nHidden=true\n' >>"$MNT/usr/share/wayland-sessions/sway.desktop.tmp"
  mv -f "$MNT/usr/share/wayland-sessions/sway.desktop.tmp" "$MNT/usr/share/wayland-sessions/sway.desktop"
fi
mkdir -p "$MNT/etc/pacman.d/hooks"
[[ -f /etc/pacman.d/hooks/etheris-hide-stock-sway.hook ]] && \
  cp -a /etc/pacman.d/hooks/etheris-hide-stock-sway.hook "$MNT/etc/pacman.d/hooks/"
# Seed ReGreet last-user/session so skip_selection lands on password.
# ReGreet CACHE_PATH is state.toml (Name= session), not legacy cache.toml/json.
mkdir -p "$MNT/var/lib/regreet"
cat >"$MNT/var/lib/regreet/state.toml" <<EOF
# Installed by etheris-installer — ReGreet CACHE_PATH is state.toml.
last_user = "${USERNAME}"

[user_to_last_sess]
${USERNAME} = "Etheris (Sway)"
EOF
# greeter owns the cache so ReGreet can rewrite after login
if arch-chroot "$MNT" id greeter >/dev/null 2>&1; then
  arch-chroot "$MNT" chown -R greeter:greeter /var/lib/regreet || true
fi
chmod 755 "$MNT/var/lib/regreet"
chmod 644 "$MNT/var/lib/regreet/state.toml"
# Drop deprecated cache files if an older ISO left them behind
rm -f "$MNT/var/lib/regreet/cache.toml" "$MNT/var/lib/regreet/cache.json"
# Ensure hide-stock-sway + regreet-cache oneshots are enabled on the installed system
for unit in etheris-hide-stock-sway.service etheris-regreet-cache.service; do
  if [[ -f "/etc/systemd/system/${unit}" ]]; then
    cp -a "/etc/systemd/system/${unit}" "$MNT/etc/systemd/system/"
    arch-chroot "$MNT" systemctl enable "$unit" 2>/dev/null || true
  fi
done
cp -a /etc/pacman.d/mirrorlist "$MNT/etc/pacman.d/mirrorlist"
# Keep multilib enabled in installed pacman.conf
if [[ -f /etc/pacman.conf ]]; then
  cp -a /etc/pacman.conf "$MNT/etc/pacman.conf"
fi
# Coherent update channel: do not leave live rolling mirrors with "stable" state.
# Prefer etheris-update rewrite; fall back to clearing stale previous-* snapshots.
if [[ -x "$MNT/usr/local/bin/etheris-update" ]]; then
  arch-chroot "$MNT" etheris-update channel stable 2>/dev/null \
    || arch-chroot "$MNT" bash -lc 'etheris-update channel stable' 2>/dev/null \
    || true
else
  printf 'stable\n' >"$MNT/var/lib/etheris/channel" 2>/dev/null || true
  rm -f "$MNT/var/lib/etheris/previous-mirrorlist" \
        "$MNT/var/lib/etheris/previous-channel" 2>/dev/null || true
fi
cp -a /etc/skel/.config "$MNT/home/${USERNAME}/" 2>/dev/null || true
arch-chroot "$MNT" chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}"

# Copy VERSION
mkdir -p "$MNT/usr/local/share/etheris"
cp /usr/local/share/etheris/VERSION "$MNT/usr/local/share/etheris/VERSION" 2>/dev/null \
  || echo "$VERSION" > "$MNT/usr/local/share/etheris/VERSION"

# Enable CPU oneshot after overlay (unit + binary now present)
arch-chroot "$MNT" systemctl enable etheris-cpu-setup.service 2>/dev/null || true
# immutable-prep: protect /usr on boot (Btrfs installs only; live ISO skipped via ConditionKernelCommandLine)
if [[ "$FS" == btrfs ]]; then
  if [[ -f /etc/systemd/system/etheris-immutable-protect.service ]]; then
    cp -a /etc/systemd/system/etheris-immutable-protect.service "$MNT/etc/systemd/system/"
  fi
  arch-chroot "$MNT" systemctl enable etheris-immutable-protect.service 2>/dev/null || true
  arch-chroot "$MNT" systemctl enable etheris-perf.service 2>/dev/null || true
fi

# Milestone 6 — mark first-boot OOBE needed on installed systems (never on live)
info "First-boot setup flag"
mkdir -p "$MNT/etc/etheris"
[[ -f /etc/etheris/oobe.conf ]] && cp -a /etc/etheris/oobe.conf "$MNT/etc/etheris/oobe.conf"
if [[ ! -f "$MNT/etc/etheris/oobe.conf" ]] || ! grep -qE '^enabled=1' "$MNT/etc/etheris/oobe.conf"; then
  cat >"$MNT/etc/etheris/oobe.conf" <<'OOBE'
enabled=1
page_keyboard=1
page_network=1
page_appearance=1
page_privacy=1
OOBE
fi
# root:wheel 2770/660 — wheel can complete OOBE without world-writable state
# Ownership resolved inside the target so GIDs match the installed system.
arch-chroot "$MNT" bash -c '
  set -euo pipefail
  getent group wheel >/dev/null || groupadd -r wheel
  install -d -m 2770 -o root -g wheel /var/lib/etheris/oobe
  printf "needed\n" >/var/lib/etheris/oobe/state
  chown root:wheel /var/lib/etheris/oobe/state
  chmod 660 /var/lib/etheris/oobe/state
  # Reject world-writable bits if something else remade the dir
  chmod o-rwx /var/lib/etheris/oobe /var/lib/etheris/oobe/state
'
# Live-only auth must never remain enabled/unmasked on disk installs
rm -f "$MNT/etc/systemd/system/multi-user.target.wants/etheris-auth-setup.service" \
  "$MNT/etc/systemd/system/graphical.target.wants/etheris-auth-setup.service"
rm -f "$MNT/etc/sudoers.d/etheris"
# Mask even if unit file was copied from live overlay
arch-chroot "$MNT" systemctl mask etheris-auth-setup.service 2>/dev/null \
  || ln -sf /dev/null "$MNT/etc/systemd/system/etheris-auth-setup.service"
# Ensure oobe-helper is present for non-wheel fallback
[[ -x /usr/local/bin/etheris-oobe-helper ]] && \
  cp -a /usr/local/bin/etheris-oobe-helper "$MNT/usr/local/bin/"

# Post-install hardware/driver recommendation (non-destructive)
info "Hardware / driver recommendation"
if [[ -x /usr/local/bin/etheris-hw ]]; then
  etheris-hw 2>/dev/null | tee -a "$LOG" || true
fi
if [[ -x "$MNT/usr/local/bin/etheris-drivers" ]]; then
  arch-chroot "$MNT" etheris-drivers recommend 2>/dev/null | tee -a "$LOG" || true
fi

info "Installation finished SUCCESSFULLY"
echo "Log: $LOG"
echo "Next: reboot, then run:  etheris-drivers status"
echo "NVIDIA Pascal users:     etheris-drivers pascal-guide"
echo "You can reboot into Etheris OS now."
if [[ "$AUTO" -eq 1 ]]; then
  if [[ "$NO_REBOOT" -eq 1 ]]; then
    echo "AUTO: --no-reboot set; leaving system as-is."
  else
    echo "AUTO: rebooting…"
    systemctl reboot
  fi
else
  read -r -p "Reboot now? [y/N]: " rb
  [[ "${rb,,}" == y* ]] && systemctl reboot
  echo "Done. You may reboot manually."
fi
