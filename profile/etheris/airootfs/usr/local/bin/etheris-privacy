#!/usr/bin/env bash
# Etheris privacy dashboard (CLI) — wraps policy file + security helpers
set -euo pipefail

usage() {
  cat <<'EOF'
Etheris privacy

Usage:
  etheris privacy              Overview (default)
  etheris privacy status       Same as overview
  etheris privacy firewall     → etheris-security firewall
  etheris privacy audit        → etheris-security audit
  etheris privacy help

Docs: /usr/local/share/etheris/docs/PRIVACY-AUDIT.md
EOF
}

cmd_status() {
  echo "Etheris privacy dashboard"
  echo
  if [[ -f /etc/etheris/privacy.conf ]]; then
    echo "Policy (/etc/etheris/privacy.conf):"
    grep -E '^[A-Z]' /etc/etheris/privacy.conf 2>/dev/null | sed 's/^/  /' || cat /etc/etheris/privacy.conf | sed 's/^/  /'
  else
    echo "  (no /etc/etheris/privacy.conf — using security defaults)"
  fi
  echo
  echo "Telemetry: Etheris does not ship cloud telemetry in Alpha."
  echo "Updates:   pacman via etheris-update channels only."
  echo "AUR:       optional via etheris-aur (user risk)."
  echo
  if command -v etheris-security >/dev/null; then
    etheris-security status
  fi
  echo
  echo "Deeper audit: etheris privacy audit"
  echo "Support bundle: etheris report create"
}

main() {
  case "${1:-status}" in
    status|show|"") cmd_status ;;
    firewall|fw) exec etheris-security firewall ;;
    audit) exec etheris-security audit ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
