#!/usr/bin/env bash
# Etheris OS — Spotlight-style application launcher (Rofi).
# Styles: slim (default) · wide — set launcher_style in settings.conf
# Icons: launcher_icons=on|off — off is faster on virtio/TCG (no Papirus scan).
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/etheris"
ROFI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
SETTINGS="$CONF_DIR/settings.conf"
PINS="$CONF_DIR/launcher-pins.conf"
SHARE="${ETHERIS_SHARE:-/usr/local/share/etheris}"
FAV_MODE="$SHARE/rofi/favorites.mode"
FALLBACK_WIDE="$SHARE/rofi/etheris.rasi"
FALLBACK_SLIM="$SHARE/rofi/etheris-slim.rasi"

mkdir -p "$CONF_DIR" "$ROFI_DIR"

get_setting() {
  local key="$1" def="${2:-}"
  local v
  v="$(grep -E "^${key}=" "$SETTINGS" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  [[ -n "$v" ]] && echo "$v" || echo "$def"
}

launcher_style() {
  local s
  s="$(get_setting launcher_style slim | tr '[:upper:]' '[:lower:]')"
  case "$s" in
    wide|full) echo wide ;;
    *) echo slim ;;
  esac
}

# Icons on by default (sleek grid). Off only when settings/env say so.
want_icons() {
  local s
  s="$(get_setting launcher_icons on | tr '[:upper:]' '[:lower:]')"
  case "$s" in
    off|false|0|no) return 1 ;;
  esac
  [[ "${ETHERIS_LIGHT:-0}" == "1" ]] && return 1
  return 0
}

if [[ ! -f "$PINS" ]]; then
  cat >"$PINS" <<'EOF'
# One entry per line: desktop-id (without .desktop) or absolute command
foot
etheris-files
etheris-browser
etheris-defaults
steam
etheris-settings
etheris-wallpaper
etheris-transfer
EOF
fi

# Ensure themes exist (theme-apply refreshes colours into ~/.config/rofi)
if [[ ! -f "$ROFI_DIR/etheris.rasi" && -f "$FALLBACK_WIDE" ]]; then
  cp "$FALLBACK_WIDE" "$ROFI_DIR/etheris.rasi"
fi
if [[ ! -f "$ROFI_DIR/etheris-slim.rasi" && -f "$FALLBACK_SLIM" ]]; then
  cp "$FALLBACK_SLIM" "$ROFI_DIR/etheris-slim.rasi"
fi
if [[ ! -f "$ROFI_DIR/config.rasi" ]]; then
  if [[ -f /etc/skel/.config/rofi/config.rasi ]]; then
    cp /etc/skel/.config/rofi/config.rasi "$ROFI_DIR/config.rasi"
  else
    cat >"$ROFI_DIR/config.rasi" <<EOF
configuration {
  modi: "drun,pinned:${FAV_MODE},run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "Noto Sans 12";
  terminal: "foot";
  sidebar-mode: false;
  display-drun: "Apps";
  display-pinned: "Pinned";
  display-run: "Run";
  display-window: "Windows";
  drun-display-format: "{name}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: [ MousePrimary ];
  cycle: true;
  matching: "fuzzy";
  sort: true;
  normalize-match: true;
  kb-move-char-back: "Control+b";
  kb-move-char-forward: "Control+f";
  kb-row-left: "Left";
  kb-row-right: "Right";
  kb-row-up: "Up";
  kb-row-down: "Down";
  kb-accept-entry: "Return,KP_Enter";
  kb-cancel: "Escape";
}
@theme "etheris-slim"
EOF
  fi
fi

mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/rofi/themes"
[[ -f "$ROFI_DIR/etheris.rasi" ]] && \
  ln -sfn "$ROFI_DIR/etheris.rasi" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/rofi/themes/etheris.rasi" 2>/dev/null || true
[[ -f "$ROFI_DIR/etheris-slim.rasi" ]] && \
  ln -sfn "$ROFI_DIR/etheris-slim.rasi" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/rofi/themes/etheris-slim.rasi" 2>/dev/null || true

STYLE="$(launcher_style)"
THEME="$ROFI_DIR/etheris-slim.rasi"
if [[ "$STYLE" == wide ]]; then
  if [[ -f "$ROFI_DIR/etheris.rasi" ]]; then
    THEME="$ROFI_DIR/etheris.rasi"
  elif [[ -f "$FALLBACK_WIDE" ]]; then
    THEME="$FALLBACK_WIDE"
  fi
elif [[ -f "$ROFI_DIR/etheris-slim.rasi" ]]; then
  THEME="$ROFI_DIR/etheris-slim.rasi"
elif [[ -f "$FALLBACK_SLIM" ]]; then
  THEME="$FALLBACK_SLIM"
fi

rofi_base=(
  rofi
  -config "$ROFI_DIR/config.rasi"
  -theme "$THEME"
)

if want_icons; then
  rofi_base+=(-show-icons)
else
  # Force off even if config.rasi says true (virt/light path).
  rofi_base+=(-no-show-icons)
fi

if ! command -v rofi >/dev/null 2>&1; then
  echo "etheris-launcher: rofi not installed" >&2
  if want_icons; then
    exec wofi --show drun -I -p 'Etheris' "$@"
  fi
  exec wofi --show drun -p 'Etheris' "$@"
fi

mode="${1:-}"
case "$mode" in
  pins|pinned|favorites)
    exec "${rofi_base[@]}" -show pinned
    ;;
  drun|apps)
    exec "${rofi_base[@]}" -show drun
    ;;
  run)
    exec "${rofi_base[@]}" -show run
    ;;
  window|windows)
    exec "${rofi_base[@]}" -show window
    ;;
  wide|slim)
    mkdir -p "$CONF_DIR"
    if [[ -f "$SETTINGS" ]] && grep -qE '^launcher_style=' "$SETTINGS"; then
      sed -i "s|^launcher_style=.*|launcher_style=${mode}|" "$SETTINGS"
    else
      echo "launcher_style=${mode}" >>"$SETTINGS"
    fi
    exec "$0"
    ;;
  wofi)
    shift || true
    if want_icons; then
      exec wofi --show drun -I -p 'Etheris' "$@"
    fi
    exec wofi --show drun -p 'Etheris' "$@"
    ;;
  ""|kickoff|launcher|*)
    exec "${rofi_base[@]}" -show drun
    ;;
esac
