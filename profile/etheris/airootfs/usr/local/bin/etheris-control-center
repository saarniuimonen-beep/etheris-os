                  min-width: 14px;
                  min-height: 14px;
                  margin: -5px;
                  border-radius: 999px;
                  background: #e8f4fc;
                  border: none;
                  box-shadow: 0 1px 4px alpha(#000000, 0.35);
                }
                button.cc-icon-btn {
                  padding: 4px 8px;
                  border-radius: 8px;
                  background: alpha(#122338, 0.85);
                  border: 1px solid alpha(#7dd3fc, 0.16);
                  color: #e8f4fc;
                }
                .cc-session {
                  margin-bottom: 10px;
                }
                button.cc-session-btn {
                  padding: 10px 6px;
                  border-radius: 10px;
                  font-size: 11px;
                  background: alpha(#ffffff, 0.07);
                  background-image: none;
                  border: none;
                  box-shadow: none;
                  outline: none;
                  color: #e8f4fc;
                  transition: 100ms ease;
                }
                button.cc-session-btn:hover {
                  background: alpha(#38bdf8, 0.16);
                }
                button.cc-danger {
                  background: alpha(#fb7185, 0.14);
                  color: #fecdd3;
