            )
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(),
                css,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    app = ControlCenter()

    def cleanup(_app=None):
        shutil.rmtree(tmp, ignore_errors=True)

    app.connect("shutdown", cleanup)
    return app.run(None)


def main(argv: list[str]) -> int:
    ensure_settings()
    if "--menu" in argv or os.environ.get("ETHERIS_CC_MENU") == "1":
        return run_wofi_menu()
    if "--help" in argv or "-h" in argv:
        print("Usage: etheris-control-center [--menu]")
        print("  Default: Etheris Menu GTK sheet (hover / Super+A / panel).")
        print("  --menu:  wofi fallback list.")
        return 0
    return try_gtk_sheet()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
