                  background-image: none;
                  border: none;
                  box-shadow: none;
                  outline: none;
                  color: #e8f4fc;
                  transition: 100ms ease;
                }
                button.cc-tile:hover {
                  background: alpha(#38bdf8, 0.16);
                }
                button.cc-tile-on {
                  background: alpha(#38bdf8, 0.20);
                }
                .cc-tile-label {
                  font-size: 11px;
                  color: #a8c4d8;
                }
