#!/usr/bin/env bash
# Etheris OS — live/disk desktop memberships + Steam desktop override.
# Live ISO: package sysusers create groups, but airootfs never joins users →
# GameMode renice / Bluetooth / PipeWire seat access can be a no-op.
# Steam package ships /usr/share/.../steam.desktop; we keep Exec=etheris-steam
# without a second airootfs XDG entry (duplicate basename gate).
set -euo pipefail

# Apply Etheris Steam desktop over stock package file (idempotent).
apply_steam_desktop() {
  local src=/usr/local/share/etheris/desktop/steam.desktop
  local alt=/usr/local/share/applications/steam.desktop
  [[ -f "$src" ]] || src="$alt"
  [[ -f "$src" ]] || return 0
  grep -q '^Exec=etheris-steam' "$src" || return 0
  install -Dm644 "$src" /usr/share/applications/steam.desktop
}

apply_steam_desktop

# Soft-unblock radios early (before greeter); harmless if no hardware.
if command -v rfkill >/dev/null 2>&1; then
  rfkill unblock wifi 2>/dev/null || true
  rfkill unblock bluetooth 2>/dev/null || true
fi

# Ensure common interactive groups exist, then join UID≥1000 users.
for g in audio video input render network power rfkill bluetooth gamemode; do
  groupadd -f "$g" 2>/dev/null || true
done

while IFS=: read -r name _ uid _rest; do
  [[ "$uid" =~ ^[0-9]+$ ]] || continue
  ((uid >= 1000 && uid < 65534)) || continue
  for g in audio video input render network power rfkill bluetooth; do
    getent group "$g" >/dev/null 2>&1 || continue
    if id -nG "$name" 2>/dev/null | tr ' ' '\n' | grep -qx "$g"; then
      continue
    fi
    usermod -aG "$g" "$name" 2>/dev/null || true
  done
  if getent group gamemode >/dev/null 2>&1; then
    if ! id -nG "$name" 2>/dev/null | tr ' ' '\n' | grep -qx gamemode; then
      usermod -aG gamemode "$name" 2>/dev/null || true
    fi
  fi
done < <(getent passwd)

exit 0
