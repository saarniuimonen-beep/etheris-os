#!/usr/bin/env bash
# Etheris OS — security/privacy status and light audit helpers
set -euo pipefail

cmd_help() {
  cat <<'EOF'
Etheris security helpers

Usage:
  etheris-security status     Privacy + firewall + services overview
  etheris-security firewall   Show nftables ruleset / status
  etheris-security audit      Local checklist (not a pentest)
  etheris-security help

This does NOT prove the OS is “secure”. See /usr/local/share/etheris/docs/SECURITY.md
EOF
}

cmd_status() {
  echo "Etheris security / privacy status"
  echo
  if [[ -f /etc/etheris/privacy.conf ]]; then
    echo "Privacy policy file: /etc/etheris/privacy.conf"
    grep -E '^[A-Z]' /etc/etheris/privacy.conf | sed 's/^/  /'
  else
    echo "  (privacy.conf missing)"
  fi
  echo
  echo "Package signatures:"
  if grep -qE '^SigLevel\s*=\s*Required' /etc/pacman.conf 2>/dev/null; then
    echo "  pacman SigLevel includes Required (good)"
  else
    echo "  WARNING: check /etc/pacman.conf SigLevel"
  fi
  echo
  echo "Firewall (nftables):"
  if systemctl is-active --quiet nftables 2>/dev/null; then
    echo "  nftables: active"
  elif systemctl is-enabled --quiet nftables 2>/dev/null; then
    echo "  nftables: enabled (not active in this context)"
  else
    echo "  nftables: NOT enabled"
  fi
  if command -v nft >/dev/null; then
    nft list tables 2>/dev/null | sed 's/^/  /' || echo "  (cannot list tables — need root?)"
  fi
  echo
  echo "Remote access:"
  if systemctl is-enabled --quiet sshd 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
    echo "  WARNING: sshd enabled/active"
  else
    echo "  sshd: not enabled (expected default)"
  fi
  echo
  echo "Listening sockets (may need root for full view):"
  if command -v ss >/dev/null; then
    ss -tulpn 2>/dev/null | head -30 | sed 's/^/  /' || true
  fi
}

cmd_firewall() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "Run: sudo etheris-security firewall"
    exit 1
  fi
  systemctl status nftables --no-pager -l || true
  echo
  nft list ruleset
  echo
  echo "Configure: edit /etc/nftables.conf then: sudo systemctl restart nftables"
  echo "Docs: /usr/local/share/etheris/docs/SECURITY.md"
}

# Prefer root; else passwordless sudo (live NOPASSWD). Same pattern as etheris-auth-check.
as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif sudo -n true >/dev/null 2>&1; then
    sudo -n "$@"
  else
    return 127
  fi
}

cmd_audit() {
  local ok=0 fail=0 skip=0
  pass() { echo "  OK  $*"; ok=$((ok+1)); }
  bad() { echo "FAIL  $*"; fail=$((fail+1)); }
  skip() { echo "SKIP $*"; skip=$((skip+1)); }

  echo "Etheris local security checklist"
  echo "(manual inspection helper — not a full audit)"
  echo

  grep -qE '^SigLevel\s*=\s*Required' /etc/pacman.conf 2>/dev/null \
    && pass "pacman signature verification Required" \
    || bad "pacman SigLevel not clearly Required"

  [[ -f /etc/nftables.conf ]] && pass "nftables config present" || bad "nftables.conf missing"

  if systemctl is-enabled nftables >/dev/null 2>&1; then
    pass "nftables service enabled"
  else
    bad "nftables service not enabled"
  fi

  if systemctl is-enabled sshd >/dev/null 2>&1; then
    bad "sshd is enabled (should be off by default)"
  else
    pass "sshd not enabled"
  fi
  # Prefer masked unit (rock-solid default)
  if [[ -L /etc/systemd/system/sshd.service ]] \
    && [[ "$(readlink -f /etc/systemd/system/sshd.service 2>/dev/null || readlink /etc/systemd/system/sshd.service)" == /dev/null ]]; then
    pass "sshd.service masked"
  elif [[ -d /run/archiso ]] || grep -qw archisobasedir /proc/cmdline 2>/dev/null; then
    # Live ISO should ship the mask; note if missing
    [[ -L /etc/systemd/system/sshd.service ]] \
      && pass "sshd.service masked" \
      || skip "sshd.service mask symlink (expected on Etheris images)"
  else
    skip "sshd.service mask check (optional on non-Etheris hosts)"
  fi

  if [[ -f /etc/sudoers.d/etheris ]]; then
    if as_root grep -q NOPASSWD /etc/sudoers.d/etheris 2>/dev/null; then
      echo "  NOTE live ISO: NOPASSWD sudo for wheel (convenience — not for installed systems)"
    fi
    mode=$(as_root stat -c '%a' /etc/sudoers.d/etheris 2>/dev/null || echo '?')
    [[ "$mode" == "440" || "$mode" == "0440" ]] && pass "sudoers.d mode $mode" || bad "sudoers.d mode $mode"
  fi

  if [[ -f /etc/etheris/privacy.conf ]]; then
    grep -q 'TELEMETRY=off' /etc/etheris/privacy.conf \
      && pass "privacy.conf declares TELEMETRY=off" \
      || bad "privacy.conf telemetry not off"
  else
    bad "privacy.conf missing"
  fi

  # /etc/shadow needs elevation — never false-FAIL when unreadable
  if id etheris >/dev/null 2>&1; then
    set +e
    as_root awk -F: '$1=="etheris" && $2 ~ /^\$/ {found=1} END{exit !found}' /etc/shadow 2>/dev/null
    rc=$?
    set -e
    if ((rc == 0)); then
      pass "live user has password hash (not empty)"
    elif ((rc == 127)); then
      skip "password hash (need root or sudo -n to read /etc/shadow)"
    else
      bad "user etheris has no password hash"
    fi
  else
    pass "no shared live user on this system"
  fi

  if [[ -f /etc/nftables.conf ]]; then
    grep -q 'policy drop' /etc/nftables.conf \
      && pass "nftables.conf declares policy drop" \
      || bad "nftables.conf missing policy drop"
    if grep -A6 'chain forward' /etc/nftables.conf | grep -q 'policy drop'; then
      pass "nftables forward chain policy drop"
    else
      bad "nftables forward chain missing policy drop"
    fi
    if grep -E 'dport[[:space:]]*22|[[:space:]]22[[:space:]]*accept|tcp dport 22' /etc/nftables.conf >/dev/null 2>&1; then
      bad "nftables.conf accepts port 22"
    else
      pass "nftables.conf has no port-22 accept"
    fi
  fi

  if [[ -f /etc/sysctl.d/99-etheris-security.conf ]]; then
    pass "sysctl security drop-in present"
  else
    bad "sysctl security drop-in missing"
  fi

  # Listening sockets — only fail if something is on port 22
  if command -v ss >/dev/null 2>&1; then
    echo "  Listening (summary):"
    ss -tulpn 2>/dev/null | awk 'NR==1 || /LISTEN|UNCONN/' | head -20 | sed 's/^/    /' || true
    if ss -tulpn 2>/dev/null | grep -qE ':22\s'; then
      bad "something listening on TCP/UDP 22 (SSH surface)"
    else
      pass "no listener on port 22"
    fi
  else
    skip "listening-port summary (ss missing)"
  fi

  # Disk encryption detection (informational)
  if command -v lsblk >/dev/null 2>&1; then
    if lsblk -o NAME,FSTYPE,TYPE 2>/dev/null | grep -qi crypt; then
      pass "crypt/LUKS block device detected"
    else
      echo "  NOTE: no crypt/LUKS devices (optional; not required by defaults)"
    fi
  fi

  # Sudoers inventory + installed-system NOPASSWD trap
  echo "  Sudoers inventory:"
  if [[ -d /etc/sudoers.d ]]; then
    for f in /etc/sudoers.d/*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      [[ "$base" == *~ || "$base" == *.bak ]] && continue
      mode=$(stat -c '%a' "$f" 2>/dev/null || echo '?')
      echo "    $base mode=$mode"
      if [[ "$base" == "etheris" ]] && grep -q NOPASSWD "$f" 2>/dev/null; then
        if [[ -d /run/archiso ]] || grep -qw archisobasedir /proc/cmdline 2>/dev/null; then
          echo "    NOTE: live NOPASSWD expected on live ISO"
        else
          bad "installed system still has live NOPASSWD sudoers ($base)"
        fi
      fi
    done
    if [[ -f /etc/sudoers.d/wheel ]] && grep -q '%wheel ALL=(ALL:ALL) ALL' /etc/sudoers.d/wheel; then
      pass "password sudo for wheel present"
    elif [[ -d /run/archiso ]] || grep -qw archisobasedir /proc/cmdline 2>/dev/null; then
      echo "  NOTE: wheel password sudoers not required on live ISO"
    else
      echo "  NOTE: /etc/sudoers.d/wheel not found (check sudoers policy)"
    fi
  fi

  echo
  echo "Result: ${ok} OK, ${fail} FAIL, ${skip} SKIP"
  echo "Limitations: see /usr/local/share/etheris/docs/SECURITY.md"
  (( fail == 0 ))
}

case "${1:-status}" in
  status) cmd_status ;;
  firewall|fw) cmd_firewall ;;
  audit) cmd_audit ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
