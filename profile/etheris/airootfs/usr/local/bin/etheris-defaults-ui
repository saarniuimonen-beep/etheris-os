#!/usr/bin/env python3
"""Etheris OS — Defaults manager (GTK4). Browser · Terminal · AI Agent."""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import threading
from pathlib import Path

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gtk, Pango
except (ImportError, ValueError) as exc:
    print(f"etheris-defaults-ui: GTK4 required ({exc})", file=__import__("sys").stderr)
    raise SystemExit(2) from exc

os.environ.setdefault("GSK_RENDERER", "cairo")

SHARE = Path(os.environ.get("ETHERIS_SHARE", "/usr/local/share/etheris"))
CATALOG = SHARE / "defaults" / "catalog.json"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "etheris"
SETTINGS = CONF / "settings.conf"

CSS = b"""
