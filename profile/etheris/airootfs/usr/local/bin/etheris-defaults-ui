  background: #06101c;
  color: #e8f4fc;
}
.shell { background: #06101c; }

.rail {
  background: alpha(#0a1829, 0.98);
  border-right: 1px solid alpha(#38bdf8, 0.14);
  padding: 20px 14px;
  min-width: 200px;
}
