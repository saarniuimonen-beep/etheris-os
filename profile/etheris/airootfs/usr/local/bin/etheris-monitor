#!/usr/bin/env bash
# Etheris System Monitor — lightweight wrap of sensors / perf / RAM
set -euo pipefail

usage() {
  cat <<'EOF'
Etheris system monitor

Usage:
  etheris monitor           Overview (default)
  etheris monitor watch     Refresh every 2s
  etheris monitor help

Wraps: free, sensors (if present), etheris-perf, etheris-hw gpu
EOF
}

overview() {
  echo "Etheris System Monitor"
  echo "======================"
  echo
  echo "== Memory =="
  free -h | sed 's/^/  /'
  echo
  if command -v etheris >/dev/null 2>&1; then
    echo "== Session RAM =="
    etheris ram 2>/dev/null | sed 's/^/  /' || true
    echo
  fi
  echo "== Performance profile =="
  if command -v etheris-perf >/dev/null; then
    etheris-perf status 2>/dev/null | sed 's/^/  /' || echo "  (unavailable)"
  else
    echo "  (etheris-perf missing)"
  fi
  echo
  echo "== Temperatures =="
  if command -v sensors >/dev/null; then
    sensors 2>/dev/null | sed 's/^/  /' || echo "  (sensors failed)"
  else
    echo "  (lm_sensors not installed / no sensors)"
  fi
  echo
  echo "== GPU (short) =="
  if command -v etheris-hw >/dev/null; then
    etheris-hw gpu 2>/dev/null | head -40 | sed 's/^/  /' || true
  fi
  echo
  echo "Tip: etheris monitor watch · etheris-perf set balanced"
}

watch_loop() {
  while true; do
    clear 2>/dev/null || true
    overview
    sleep 2
  done
}

case "${1:-}" in
  help|-h|--help) usage ;;
  watch|top) watch_loop ;;
  *) overview ;;
esac
