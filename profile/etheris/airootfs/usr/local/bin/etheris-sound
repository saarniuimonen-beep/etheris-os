#!/usr/bin/env bash
# Etheris OS — startup sound preferences (per-user, no background daemon)
set -euo pipefail

SHARE="${ETHERIS_SHARE:-/usr/local/share/etheris}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/etheris"
CONF="$CONF_DIR/sound.conf"
DEFAULT_WAV="$SHARE/sounds/startup.wav"
GUARD="${XDG_RUNTIME_DIR:-/tmp}/etheris-startup-sound.played"

ensure_conf() {
  mkdir -p "$CONF_DIR"
  if [[ ! -f "$CONF" ]]; then
    cat >"$CONF" <<'EOF'
# Etheris OS sound preferences (per-user)
startup_enabled=0
startup_volume=40
# startup_file=   # optional absolute path to custom WAV/OGG
EOF
  fi
}

get() {
  local key="$1" def="${2:-}"
  ensure_conf
  local v
  v="$(grep -E "^${key}=" "$CONF" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  [[ -n "$v" ]] && echo "$v" || echo "$def"
}

set_key() {
  local key="$1" val="$2"
  ensure_conf
  if grep -qE "^${key}=" "$CONF" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$CONF"
  else
    echo "${key}=${val}" >>"$CONF"
  fi
}

sound_file() {
  local custom
  custom="$(get startup_file "")"
  if [[ -n "$custom" && -f "$custom" ]]; then
    echo "$custom"
  else
    echo "$DEFAULT_WAV"
  fi
}

play_file() {
  local file="$1" vol
  vol="$(get startup_volume 40)"
  [[ -f "$file" ]] || return 1
  # volume 0–100 → linear gain for players that support it
  # Prefer absolute paths — session PATH can be minimal
  if [[ -x /usr/bin/pw-play ]]; then
    local gain
    gain="$(awk -v v="$vol" 'BEGIN{printf "%.3f", (v+0)/100}')"
    /usr/bin/pw-play --volume="$gain" "$file" >/dev/null 2>&1 && return 0
  fi
  if [[ -x /usr/bin/paplay ]]; then
    local raw
    raw="$(awk -v v="$vol" 'BEGIN{printf "%d", (v+0)*655.36}')"
    /usr/bin/paplay --volume="$raw" "$file" >/dev/null 2>&1 && return 0
  fi
  if command -v pw-play >/dev/null 2>&1; then
    pw-play "$file" >/dev/null 2>&1 && return 0
  fi
  if command -v paplay >/dev/null 2>&1; then
    paplay "$file" >/dev/null 2>&1 && return 0
  fi
  return 1
}

cmd_status() {
  ensure_conf
  echo "startup_enabled=$(get startup_enabled 0)"
  echo "startup_volume=$(get startup_volume 40)"
  echo "startup_file=$(sound_file)"
  echo "default_file=$DEFAULT_WAV"
  echo "conf=$CONF"
  if pgrep -u "$UID" -x pipewire >/dev/null 2>&1; then
    echo "pipewire=running"
  else
    echo "pipewire=stopped"
  fi
  if command -v wpctl >/dev/null 2>&1; then
    sink="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
    src="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
    echo "default_sink=${sink:-unknown}"
    echo "default_source=${src:-unknown}"
  elif command -v pactl >/dev/null 2>&1; then
    echo "default_sink=$(pactl get-default-sink 2>/dev/null || echo unknown)"
    echo "default_source=$(pactl get-default-source 2>/dev/null || echo unknown)"
  fi
}

cmd_preview() {
  local f
  f="$(sound_file)"
  if ! play_file "$f"; then
    echo "No audio player available (need pw-play or paplay)." >&2
    return 1
  fi
  echo "Played: $f"
}

cmd_play_startup() {
  # Called from apply-session — once per login, only if enabled
  [[ "$(get startup_enabled 0)" == "1" ]] || return 0
  [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] || return 0
  if [[ -f "$GUARD" ]]; then
    return 0
  fi
  : >"$GUARD" 2>/dev/null || true
  play_file "$(sound_file)" || true
}

cmd_help() {
  cat <<EOF
Etheris OS — sound

  etheris-sound status
  etheris-sound enable|disable
  etheris-sound preview
  etheris-sound volume <0-100>
  etheris-sound reset
  etheris-sound play-startup   # used by session start (no-op if disabled)

Default startup sound is off (quiet environments). Enable with: etheris sound enable
EOF
}

main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    status) cmd_status ;;
    enable) set_key startup_enabled 1; echo "startup_enabled=1" ;;
    disable) set_key startup_enabled 0; echo "startup_enabled=0" ;;
    preview|test) cmd_preview ;;
    volume)
      local v="${1:-}"
      [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 0 && v <= 100 )) || { echo "volume must be 0–100" >&2; exit 1; }
      set_key startup_volume "$v"
      echo "startup_volume=$v"
      ;;
    reset)
      rm -f "$CONF"
      ensure_conf
      echo "Reset $CONF"
      ;;
    play-startup) cmd_play_startup ;;
    help|-h|--help) cmd_help ;;
    *) cmd_help; exit 1 ;;
  esac
}

main "$@"
