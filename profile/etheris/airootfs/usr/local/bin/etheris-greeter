#!/usr/bin/env bash
# Etheris OS — greeter wrapper (ReGreet with Cairo + TUI fallback).
# Used from /etc/greetd/sway-config so a ReGreet crash does not blank-loop.
set -euo pipefail

export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export GDK_BACKEND="${GDK_BACKEND:-wayland}"

if command -v regreet >/dev/null 2>&1; then
  if regreet; then
    exit 0
  fi
  echo "etheris-greeter: regreet failed (exit $?) — falling back to TUI" >&2
fi

if command -v etheris-greeter-tui >/dev/null 2>&1; then
  exec etheris-greeter-tui
fi

# Last resort: tuigreet if present
if command -v tuigreet >/dev/null 2>&1; then
  exec tuigreet --remember --time --cmd etheris-session
fi

echo "etheris-greeter: no greeter binary available" >&2
exit 1
