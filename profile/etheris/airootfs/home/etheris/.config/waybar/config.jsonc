{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,
  "modules-left": ["custom/logo", "sway/workspaces", "custom/overview", "sway/mode", "sway/window", "custom/winctl"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "custom/bluetooth", "network", "memory", "battery", "custom/cc", "custom/power"],
  "custom/logo": {
    "format": "etheris",
    "tooltip": "Etheris OS — Super+D launcher",
    "on-click": "etheris-overlay launcher",
    "on-click-right": "etheris-overlay launcher pins"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "◉",
      "focused": "●",
      "default": "○"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },
  "sway/mode": {
    "format": " {} "
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 36,
    "tooltip": true
  },
  "custom/winctl": {
    "format": "✕  −  ▭  ⛶",
    "tooltip": "Window: left=close · middle=scratch(min) · right=fullscreen · Super+Shift+A menu · Super+Shift+click float via menu",
    "on-click": "etheris-winctl close",
    "on-click-middle": "etheris-winctl scratch",
    "on-click-right": "etheris-winctl fullscreen",
    "on-scroll-up": "etheris-winctl float",
    "on-scroll-down": "etheris-winctl restore"
  },
  "custom/overview": {
    "format": "overview",
    "tooltip": "Workspace overview — Super+W",
    "on-click": "etheris-overlay menu etheris-workspace-overview"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %a}",
    "interval": 30,
    "on-click": "etheris-overlay control-center"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 6
  },
  "memory": {
    "format": "{used:0.1f}G",
    "interval": 15,
    "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G — ≤0.5G idle aspirational"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "mute",
    "format-source": "mic {volume}%",
    "format-source-muted": "mic off",
    "tooltip-format": "{desc}\nSink {volume}% · Source {source_volume}%\nLeft: Menu · Middle: pavucontrol · Right: mute · Scroll: volume",
    "on-click": "etheris-overlay control-center",
    "on-click-right": "etheris-volume mute",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "etheris-volume --quiet up",
    "on-scroll-down": "etheris-volume --quiet down"
  },
  "custom/bluetooth": {
    "exec": "etheris-bt-status",
    "return-type": "json",
    "interval": 8,
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power on",
    "on-click-middle": "blueman-applet"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "lan",
    "format-linked": "link",
    "format-disconnected": "off",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} · {ifname}\nLeft: Menu · Right: nmtui · Middle: connection editor",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}\nLeft: Menu · Right: nmtui",
    "tooltip-format-disconnected": "Disconnected — click Menu or right-click nmtui",
    "interval": 8,
    "on-click": "etheris-overlay control-center",
    "on-click-right": "foot -e nmtui",
    "on-click-middle": "nm-connection-editor"
  },
  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}%+",
    "interval": 30,
    "states": { "warning": 20, "critical": 10 },
    "on-click": "etheris-overlay control-center"
  },
  "custom/cc": {
    "format": "Menu",
    "tooltip": "Etheris Menu — hover or Super+A",
    "on-click": "etheris-overlay control-center"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": "Power menu — Super+Shift+E",
    "on-click": "etheris-overlay power"
  }
}
