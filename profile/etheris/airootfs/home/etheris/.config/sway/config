# Etheris OS — Sway default config (edit freely)
# Mod key
set $mod Mod4
set $term etheris-terminal
set $menu etheris-overlay launcher
set $files pcmanfm
set $browser etheris-browser
set $agent etheris-agent
set $cc etheris-overlay control-center
set $notif etheris-overlay notifications

# Etheris borders (overridden by ~/.config/sway/config.d/20-etheris-colors on apply)
# Etheris chrome colours (overridden by config.d/20-etheris-colors on apply)
client.focused          #38bdf8 #122338 #e8f4fc #2dd4bf #38bdf8
client.focused_inactive #1e3a5f #0a1628 #a8c4d8 #0a1628 #1e3a5f
client.unfocused        #1e3a5f #0a1628 #a8c4d8 #0a1628 #1e3a5f
client.urgent           #fb7185 #0a1628 #e8f4fc #fb7185 #fb7185

font pango:JetBrainsMono Nerd Font 10
# Etheris title strip (title text only — Sway has no SSD buttons; see docs/WINDOW-DECORATIONS.md)
default_border normal
default_floating_border normal
titlebar_padding 3 10
title_align center
gaps inner 8
gaps outer 10
smart_gaps on

output * bg /usr/local/share/etheris/wallpapers/ocean-glass.png fill

# Fast session bring-up: theme/wallpaper, then shell. Motion only if enabled.
exec etheris apply-session
exec mako
# Restore DND from settings after mako is up (Pulse / notification maturity)
exec sh -c 'sleep 0.4; etheris-notifications restore-dnd'
exec waybar
# Hover hitbox over the Waybar "menu" chip (Waybar has no on-hover action).
exec sh -c 'sleep 0.35; etheris-menu-hover'
exec sh -c 'grep -qE "^animations=(on|1|true)$" "${XDG_CONFIG_HOME:-$HOME/.config}/etheris/settings.conf" 2>/dev/null && exec etheris-motion || true'
exec sh -c 'sleep 0.5; etheris-widgets apply'
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Prepare lean Firefox profile early (warm resident only if browser_preload=on).
# Default off keeps ≤500 MiB idle; Super+B still uses lean profile (docs/IDLE-RAM-CRITERIA.md).
exec sh -c 'sleep 0.35; etheris-browser --preload'
exec swayidle -w \
    timeout 600 'etheris-lock' \
    before-sleep 'etheris-lock'

# Input
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# Keys
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+space exec $menu
bindsym $mod+a exec $cc
bindsym $mod+n exec $notif
bindsym $mod+w exec etheris-overlay menu etheris-workspace-overview
bindsym $mod+comma exec etheris-settings
bindsym $mod+Shift+a exec etheris-overlay winctl
bindsym $mod+e exec $files
bindsym $mod+b exec $browser
bindsym $mod+i exec $agent
# Close focused window (Alt+F4 primary; Super+Q / Super+Shift+Q also)
bindsym Alt+F4 kill
bindsym $mod+q kill
bindsym $mod+Shift+q kill
# Cycle open windows on the current workspace (toplevel views)
bindsym --inhibited Alt+Tab exec etheris-focus-cycle next
bindsym --inhibited Alt+Shift+Tab exec etheris-focus-cycle prev
# Scratchpad hide/show (not Windows-style minimize — see docs/KEYBOARD.md)
bindsym $mod+h move scratchpad
bindsym $mod+Shift+h scratchpad show
bindsym $mod+Shift+e exec etheris-overlay power
bindsym $mod+l exec etheris-lock
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Shortcut Center
bindsym $mod+slash exec etheris-shortcuts

# OOBE when needed. First-login guide once on installed systems only
# (etheris-guide no-ops on live ISO and when already completed).
exec sh -c 'sleep 0.3; etheris-oobe maybe-run'
exec sh -c 'sleep 2; etheris-guide'

# Screenshots → ~/Pictures/Screenshots (and clipboard)
bindsym Print exec sh -c 'd="$HOME/Pictures/Screenshots"; mkdir -p "$d"; f="$d/Etheris-$(date +%Y%m%d-%H%M%S).png"; grim "$f" && wl-copy < "$f"'
bindsym Shift+Print exec sh -c 'd="$HOME/Pictures/Screenshots"; mkdir -p "$d"; f="$d/Etheris-$(date +%Y%m%d-%H%M%S).png"; grim -g "$(slurp)" "$f" && wl-copy < "$f"'

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Resize mode
mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up resize shrink height 20px
    bindsym Down resize grow height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
