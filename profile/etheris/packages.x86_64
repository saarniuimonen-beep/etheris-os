wine-mono
wine-gecko
winetricks
zenity
cabextract
vkd3d
openal
# Proton helpers (Steam Play + non-Steam)
protontricks
umu-launcher
# Media codecs often needed by launchers / in-game video
gst-plugins-base
gst-plugins-good
gst-plugins-bad
gst-libav
# Controllers / Bluetooth peripherals
bluez
bluez-utils
# GameMode is on-demand (no always-on max performance)

# --- CPU / lighting helpers ---
lm_sensors
cpupower
# Motherboard / case ARGB via OpenRGB (Etheris RGB Manager)
openrgb
# Compressed RAM swap — prevents Steam/browser OOM kills without a disk swapfile
zram-generator

# essentials
imv
file-roller
# Pin providers so mkarchiso/pacstrap never waits on interactive prompts
iptables
nftables
